{
 "schema": 1,
 "name": "nomacs",
 "summary": "[Nomacs](https://github.com/nomacs/nomacs) is a free, open source image viewer, which supports multiple platforms. You can use it for viewing all common image formats including RAW and psd images.",
 "upstream": {
  "url": "https://github.com/nomacs/nomacs",
  "version": {
   "type": "github_release",
   "repo": "nomacs/nomacs",
   "require_assets": [
    {
     "asset": "^nomacs\\-linux\\-x86_64\\.AppImage$"
    },
    {
     "asset": "^nomacs\\-linux\\-aarch64\\.AppImage$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "nomacs/nomacs"
  }
 },
 "release": {
  "branch": "main",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "NOMACS_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 3001,
   "scheme": "https",
   "screenshot_delay": 45
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Nomacs desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Nomacs desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/nomacs/config",
    "description": "User's home directory in the container, stores program settings and images"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Image Editor"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/nomacs-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-10-13",
   "text": "Initial release."
  }
 ]
}
