{
 "schema": 1,
 "name": "doublecommander",
 "summary": "[Double Commander](https://doublecmd.sourceforge.io/) is a free cross platform open source file manager with two panels side by side. It is inspired by Total Commander and features some new ideas.",
 "upstream": {
  "url": "https://doublecmd.sourceforge.io/",
  "version": {
   "type": "os"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "DOUBLECOMMAND_RELEASE",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Double Commander desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Double Commander desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings."
   },
   {
    "path": "/data",
    "host_path": "/path/to/data",
    "description": "Host data directories, mount as many as needed."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Administration",
   "Storage"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/doublecommander-icon.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-04-03",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-09-22",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2025-07-28",
   "text": "Fix CPU usage bug by disabling fake udev."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-07-05",
   "text": "Add rar, 7zip, ace, and arj archive support."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon, rebase to bookworm."
  },
  {
   "date": "2023-07-05",
   "text": "Deprecate armhf. As announced [here](https://www.linuxserver.io/blog/a-farewell-to-arm-hf)"
  },
  {
   "date": "2023-03-18",
   "text": "Rebase to KasmVNC base image."
  },
  {
   "date": "2022-09-16",
   "text": "Migrate to s6v3."
  },
  {
   "date": "2022-02-15",
   "text": "Rebase to Ubuntu Jammy."
  },
  {
   "date": "2021-12-14",
   "text": "Rebase to Ubuntu focal."
  },
  {
   "date": "2020-03-25",
   "text": "Initial release."
  }
 ]
}
