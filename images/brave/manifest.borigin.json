{
 "schema": 1,
 "name": "brave",
 "summary": "brave container image.",
 "upstream": {
  "version": {
   "type": "deb_packages",
   "index_url": "https://brave-browser-apt-nightly.s3.brave.com/dists/stable/main/binary-amd64/Packages.gz",
   "package": "brave-browser-nightly"
  },
  "notes": {
   "type": "github_release",
   "repo": "brave/brave-browser",
   "tag": "v${VERSION}"
  }
 },
 "release": {
  "branch": "borigin",
  "tag": "origin",
  "channel": "prerelease"
 },
 "build": {
  "base": "selkies",
  "version_arg": "BRAVE_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {},
 "docs": {
  "categories": [
   "Web Browser"
  ],
  "custom_readme": "Up to date documentation is available [here](https://github.com/linuxserver/docker-brave/blob/master/README.md).\n"
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 }
}
