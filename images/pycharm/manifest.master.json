{
 "schema": 1,
 "name": "pycharm",
 "summary": "[PyCharm](https://www.jetbrains.com/pycharm/) offers out-of-the-box support for Python, databases, Jupyter, Git, Conda, PyTorch, TensorFlow, Hugging Face, Django, Flask, FastAPI, and more.",
 "upstream": {
  "url": "https://www.jetbrains.com/pycharm/",
  "version": {
   "type": "arch_package",
   "package": "pycharm-community-edition"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "PYCHARM_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "PyCharm desktop gui HTTP must be proxied."
   },
   {
    "internal": "3001",
    "description": "PyCharm desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores local files and settings"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Programming"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/pycharm-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-04-04",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-12-02",
   "text": "Initial Version."
  }
 ]
}
