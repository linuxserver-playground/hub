{
 "schema": 1,
 "name": "radarr",
 "summary": "[Radarr](https://github.com/Radarr/Radarr) - A fork of Sonarr to work with movies à la Couchpotato.",
 "upstream": {
  "url": "https://github.com/Radarr/Radarr",
  "version": {
   "type": "json",
   "url": "https://radarr.servarr.com/v1/update/develop/changes?runtime=netcore%26os=linuxmusl",
   "jq": ".[0].version"
  },
  "notes": {
   "type": "github_release",
   "repo": "Radarr/Radarr",
   "tag": "v${VERSION}"
  },
  "sponsor": [
   {
    "name": "Radarr",
    "url": "https://opencollective.com/radarr"
   }
  ]
 },
 "release": {
  "branch": "develop",
  "tag": "develop",
  "channel": "prerelease",
  "tags": [
   {
    "tag": "latest",
    "description": "Stable Radarr releases"
   },
   {
    "tag": "develop",
    "description": "Radarr releases from their develop branch"
   },
   {
    "tag": "nightly",
    "description": "Radarr releases from their nightly branch"
   }
  ]
 },
 "build": {
  "base": "alpine",
  "version_arg": "RADARR_RELEASE",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 240,
  "web": {
   "port": 7878,
   "path": "/system/status"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "7878",
    "description": "The port for the Radarr web UI"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/radarr/data",
    "description": "Database and Radarr configs"
   },
   {
    "path": "/movies",
    "host_path": "/path/to/movies",
    "description": "Location of Movie library on disk (See note in Application setup)",
    "optional": true
   },
   {
    "path": "/downloads",
    "host_path": "/path/to/download-client-downloads",
    "description": "Location of download managers output directory (See note in Application setup)",
    "optional": true
   }
  ],
  "readonly": {
   "supported": true
  },
  "nonroot": {
   "supported": true
  }
 },
 "docs": {
  "categories": [
   "Media Management"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/radarr.png",
  "setup": "Access the webui at `<your-ip>:7878`, for more information check out [Radarr](https://github.com/Radarr/Radarr).\n",
  "notices": {
   "media": true
  }
 },
 "proxy": {
  "port": 7878,
  "subdomain": true,
  "subfolder": {
   "supported": true,
   "base_url_note": "Settings → General → URL Base, set to /radarr"
  },
  "api_locations": [
   "/api"
  ]
 },
 "changelog": [
