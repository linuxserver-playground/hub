:"oneshot","depends_on":[],"source":"base"},{"name":"init-migrations","type":"oneshot","depends_on":[],"source":"base"},{"name":"init-modmanager-config","type":"oneshot","depends_on":["init-config"],"source":"image","script":"#!/usr/bin/with-contenv bash\n# shellcheck shell=bash\n\nCRON_MINS=$((0 + RANDOM % 59))\n\nsed -i \"s/@@MINUTES@@/${CRON_MINS}/\" /etc/crontabs/root\n\nif [[ $(date \"+%-H\") == 0 && $(date \"+%-M\") -lt ${CRON_MINS} ]]; then\n    NEXT_HOUR=0\nelif [[ $(date \"+%-H\") == 6 && $(date \"+%-M\") -lt ${CRON_MINS} ]]; then\n    NEXT_HOUR=6\nelif [[ $(date \"+%-H\") == 12 && $(date \"+%-M\") -lt ${CRON_MINS} ]]; then\n    NEXT_HOUR=12\nelif [[ $(date \"+%-H\") == 18 && $(date \"+%-M\") -lt ${CRON_MINS} ]]; then\n    NEXT_HOUR=18\nelif [[ $(date \"+%-H\") -ge 0 && $(date \"+%-H\") -le 5 ]]; then\n    NEXT_HOUR=6\nelif [[ $(date \"+%-H\") -ge 6 && $(date \"+%-H\") -le 11 ]]; then\n    NEXT_HOUR=12\nelif [[ $(date \"+%-H\") -ge 12 && $(date \"+%-H\") -le 17 ]]; then\n    NEXT_HOUR=18\nelif [[ $(date \"+%-H\") -ge 18 && $(date \"+%-H\") -le 23 ]]; then\n    NEXT_HOUR=0\nfi\n\necho \"[mod-init] Mod updates will run every 6 hours at ${CRON_MINS} minutes past the hour. Next update will be at $(date -d${NEXT_HOUR}:${CRON_MINS} '+%H:%M').\"\n\nprintf %s \"${DOCKER_MODS}\" > /run/s6/container_environment/DOCKER_MODS_STATIC\n\n/app/update-mods.sh\n"},{"name":"init-mods","type":"oneshot","depends_on":["init-config-end"],"source":"base"},{"name":"init-mods-end","type":"oneshot","depends_on":["init-mods-package-install"],"source":"base"},{"name":"init-mods-package-install","type":"oneshot","depends_on":["init-mods"],"source":"base"},{"name":"init-os-end","type":"oneshot","depends_on":["init-adduser","init-device-perms","init-envfile"],"source":"base"},{"name":"init-services","type":"oneshot","depends_on":["init-custom-files"],"source":"base"},{"name":"svc-cron","type":"longrun","depends_on":["init-services"],"source":"base"},{"name":"user","type":"bundle","depends_on":[],"source":"base"},{"name":"user2","type":"bundle","depends_on":[],"source":"base"}],"d2":"\"modmanager:latest\": {\n  docker-mods\n  base {\n    fix-attr +\\nlegacy cont-init\n  }\n  docker-mods -> base\n  legacy-services\n  custom services\n  init-services -> legacy-services\n  init-services -> custom services\n  custom services -> legacy-services\n  legacy-services -> ci-service-check\n  init-migrations -> init-adduser\n  init-os-end -> init-config\n  init-config -> init-config-end\n  init-crontab-config -> init-config-end\n  init-modmanager-config -> init-config-end\n  init-config -> init-crontab-config\n  init-modmanager-config -> init-crontab-config\n  init-mods-end -> init-custom-files\n  init-adduser -> init-device-perms\n  base -> init-envfile\n  base -> init-migrations\n  init-config -> init-modmanager-config\n  init-config-end -> init-mods\n  init-mods-package-install -> init-mods-end\n  init-mods -> init-mods-package-install\n  init-adduser -> init-os-end\n  init-device-perms -> init-os-end\n  init-envfile -> init-os-end\n  init-custom-files -> init-services\n  init-services -> svc-cron\n  svc-cron -> legacy-services\n}\nBase Images: {\n  \"baseimage-alpine:3.24\"\n}\n\"modmanager:latest\" <- Base Images\n"},"packages":{"amd64":{"count":54,"distro":"Alpine Linux v3.24","hash":"9c4ddecb","by_type":{"apk":52,"go-module":2}},"arm64":{"count":54,"distro":"Alpine Linux v3.24","hash":"9c4ddecb","by_type":{"apk":52,"go-module":2}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-modmanager/compare/e04542ce-ls1...e04542ce-ls2"}}
