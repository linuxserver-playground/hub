{
 "schema": 1,
 "name": "pwndrop",
 "summary": "[Pwndrop](https://github.com/kgretzky/pwndrop) is a self-deployable file hosting service for sending out red teaming payloads or securely sharing your private files over HTTP and WebDAV.",
 "upstream": {
  "url": "https://github.com/kgretzky/pwndrop",
  "version": {
   "type": "github_release",
   "repo": "kgretzky/pwndrop"
  },
  "notes": {
   "type": "github_release",
   "repo": "kgretzky/pwndrop"
  },
  "sponsor": [
   {
    "name": "Pwndrop - Patreon",
    "url": "https://patreon.com/mrgretzky"
   },
   {
    "name": "Pwndrop - Ko-fi",
    "url": "https://ko-fi.com/mrgretzky"
   },
   {
    "name": "Pwndrop - Liberapay",
    "url": "https://liberapay.com/mrgretzky"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "alpine",
  "version_arg": "PWNDROP_RELEASE",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 8080,
   "path": "/pwndrop",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "8080",
    "description": "web gui"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/pwndrop/appdata",
    "description": "Contains all relevant configuration and data."
   }
  ],
  "env": [
   {
    "name": "SECRET_PATH",
    "value": "/pwndrop",
    "description": "Secret path for admin access. Defaults to `/pwndrop`. This parameter only takes effect during initial install; it can later be changed in the web gui.",
    "optional": true
   }
  ]
 },
 "docs": {
  "categories": [
   "File Sharing",
   "Security"
  ],
  "logo": "https://raw.githubusercontent.com/kgretzky/pwndrop/master/media/pwndrop-logo-512.png",
  "setup": "Access the web gui at `http://<your-ip>:8080/pwndrop` (replace `/pwndrop` with your `SECRET_PATH` if you set one).\n"
 },
 "proxy": {
  "port": 8080,
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-07-17",
   "text": "Rebase to Alpine 3.24."
  },
  {
   "date": "2024-06-04",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-03-20",
   "text": "Rebase to Alpine 3.19."
  },
  {
   "date": "2023-08-07",
   "text": "Rebase to Alpine 3.18."
  },
  {
   "date": "2023-07-03",
   "text": "Deprecate armhf. As announced [here](https://www.linuxserver.io/blog/a-farewell-to-arm-hf)"
  },
  {
   "date": "2023-02-13",
   "text": "Rebase to Alpine 3.17, migrate to s6v3."
  },
  {
   "date": "2022-09-19",
   "text": "Rebasing to alpine 3.15."
  },
  {
   "date": "2021-01-23",
   "text": "Rebasing to alpine 3.13."
  },
  {
   "date": "2020-06-01",
   "text": "Rebasing to alpine 3.12."
  },
  {
   "date": "2020-04-17",
   "text": "Initial Release."
  }
 ]
}
