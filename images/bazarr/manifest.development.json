{
 "schema": 1,
 "name": "bazarr",
 "summary": "[Bazarr](https://github.com/morpheus65535/bazarr) is a companion application to Sonarr and Radarr. It can manage and download subtitles based on your requirements. You define your preferences by TV show or movie and Bazarr takes care of everything for you.",
 "upstream": {
  "url": "https://github.com/morpheus65535/bazarr",
  "version": {
   "type": "github_release",
   "repo": "morpheus65535/bazarr",
   "prerelease": true
  },
  "notes": {
   "type": "github_release",
   "repo": "morpheus65535/bazarr"
  },
  "sponsor": [
   {
    "name": "Bazarr",
    "url": "https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=XHHRWXT9YB7WE&source=url"
   }
  ]
 },
 "release": {
  "branch": "development",
  "tag": "development",
  "channel": "prerelease"
 },
 "build": {
  "base": "alpine",
  "version_arg": "BAZARR_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 6767,
   "path": "/system/status"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "6767",
    "description": "Allows HTTP access to the internal webserver."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/bazarr/config",
    "description": "Persistent config files"
   }
  ],
  "readonly": {
   "supported": true
  },
  "nonroot": {
   "supported": true
  }
 },
 "docs": {
  "categories": [
   "Media Management"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/bazarr.png",
  "setup": "- Once running the URL will be `http://<host-ip>:6767`.\n- You must complete all the setup parameters in the webui before you can save the config.\n"
 },
 "proxy": {
  "port": 6767,
  "subdomain": true,
  "subfolder": {
   "supported": true,
   "base_url_note": "Settings → General → URL Base, set to /bazarr"
  },
  "api_locations": [
   "/api"
  ]
 },
