{
 "schema": 1,
 "name": "orcaslicer",
 "summary": "[Orca Slicer](https://github.com/SoftFever/OrcaSlicer) is an open source slicer for FDM printers. OrcaSlicer is fork of Bambu Studio, it was previously known as BambuStudio-SoftFever, Bambu Studio is forked from PrusaSlicer by Prusa Research, which is from Slic3r by Alessandro Ranellucci and the RepRap community",
 "upstream": {
  "url": "https://github.com/SoftFever/OrcaSlicer",
  "version": {
   "type": "github_release",
   "repo": "OrcaSlicer/OrcaSlicer",
   "require_assets": [
    {
     "asset": "Ubuntu2404_V.*\\.AppImage$"
    },
    {
     "asset": "Ubuntu2404_aarch64.*\\.AppImage$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "OrcaSlicer/OrcaSlicer"
  },
  "sponsor": [
   {
    "name": "OrcaSlicer",
    "url": "https://paypal.me/softfever3d"
   },
   {
    "name": "OrcaSlicer (GitHub Sponsors)",
    "url": "https://github.com/sponsors/SoftFever"
   },
   {
    "name": "OrcaSlicer (Ko-fi)",
    "url": "https://ko-fi.com/SoftFever"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "ORCASLICER_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Orca Slicer desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Orca Slicer desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and files."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "We set this to 1 gig to prevent modern web browsers from crashing",
    "optional": true
   }
  ]
 },
 "docs": {
  "categories": [
   "3D Printing"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/orcaslicer-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-10-18",
   "text": "Force OrcaSlicer to use the X11 GDK backend to fix UI rendering issues under Wayland."
  },
  {
   "date": "2026-06-20",
   "text": "Add aarch64 platform."
  },
  {
   "date": "2026-05-11",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2026-04-19",
   "text": "Rebase to resolute."
  },
  {
   "date": "2026-03-29",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2026-01-01",
   "text": "Add wayland init."
  },
  {
   "date": "2025-11-25",
   "text": "Update project repo name."
  },
  {
   "date": "2025-09-15",
   "text": "Rebase to Ubuntu Noble and Selkies, HTTPS is now required."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon."
  },
  {
   "date": "2023-11-15",
   "text": "Initial release."
  }
 ]
}
