{
 "schema": 1,
 "name": "thunderbird",
 "summary": "[Thunderbird](https://www.thunderbird.net/) is a free and open-source personal information manager primarily used as an e-mail client with a calendar and contactbook, as well as an RSS feed reader, chat client, and news client.",
 "upstream": {
  "url": "https://www.thunderbird.net/",
  "version": {
   "type": "deb_packages",
   "index_url": "http://ppa.launchpad.net/mozillateam/ppa/ubuntu/dists/noble/main/binary-amd64/Packages.gz",
   "package": "thunderbird"
  },
  "sponsor": [
   {
    "name": "Donate to Thunderbird",
    "url": "https://www.thunderbird.net/en-US/donate/"
   },
   {
    "name": "Thunderbird giving FAQ",
    "url": "https://give.thunderbird.net/"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "THUNDERBIRD_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Thunderbird desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Thunderbird desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and files."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Email"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/thunderbird-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-05-31",
   "text": "Rebase to resolute."
  },
  {
   "date": "2026-04-04",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-12-02",
   "text": "Initial release."
  }
 ]
}
