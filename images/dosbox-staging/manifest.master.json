{
 "schema": 1,
 "name": "dosbox-staging",
 "summary": "[DOSBox Staging](https://www.dosbox-staging.org/) is a modern continuation of DOSBox a free and open-source emulator that enables the execution of MS-DOS software, especially video games.",
 "upstream": {
  "url": "https://www.dosbox-staging.org/",
  "version": {
   "type": "github_release",
   "repo": "dosbox-staging/dosbox-staging",
   "require_assets": [
    {
     "asset": "^dosbox\\-staging\\-linux\\-x86_64\\-.*\\.tar\\.xz$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "dosbox-staging/dosbox-staging"
  },
  "sponsor": [
   {
    "name": "DOSBox Staging (GitHub Sponsors)",
    "url": "https://github.com/sponsors/dosbox-staging"
   },
   {
    "name": "DOSBox Staging (Open Collective)",
    "url": "https://opencollective.com/dosbox-staging"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "DSTAGING_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "DOSBox Staging desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "DOSBox Staging desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and files."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Games"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/dosbox-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-05",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-08-30",
   "text": "Initial release."
  }
 ]
}
