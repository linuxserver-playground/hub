{
 "schema": 1,
 "name": "shotcut",
 "summary": "[Shotcut](https://www.shotcut.org/) is a free, open source, cross-platform video editor.",
 "upstream": {
  "url": "https://www.shotcut.org/",
  "version": {
   "type": "github_release",
   "repo": "mltframework/shotcut",
   "require_assets": [
    {
     "asset": "x86_64.*\\.txz$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "mltframework/shotcut"
  },
  "sponsor": [
   {
    "name": "Shotcut PayPal donate",
    "url": "https://www.paypal.com/donate?hosted_button_id=XD364WFCHD46N"
   }
  ]
 },
 "release": {
  "branch": "main",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "SHOTCUT_RELEASE",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Shotcut desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Shotcut desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/data",
    "description": "Where Shotcut should store its config."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Video Editor"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/shotcut-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-30",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2026-02-05",
   "text": "Disable gamepad interposer."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-09-22",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-01-31",
   "text": "Initial release."
  }
 ]
}
