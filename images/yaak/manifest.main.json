{
 "schema": 1,
 "name": "yaak",
 "summary": "[Yaak](https://yaak.app/) is a desktop API client for organizing and executing REST, GraphQL, and gRPC requests. It's built using [Tauri](https://tauri.app/), [Rust](https://www.rust-lang.org/), and [ReactJS](https://react.dev/).",
 "upstream": {
  "url": "https://yaak.app/",
  "version": {
   "type": "github_release",
   "repo": "mountain-loop/yaak",
   "exclude": "yaak-cli",
   "sort": "version",
   "require_assets": [
    {
     "asset": "^(?!.*cef).*amd64.*\\.deb$"
    },
    {
     "asset": "^(?!.*cef).*arm64.*\\.deb$"
    }
   ]
  },
  "sponsor": [
   {
    "name": "Yaak",
    "url": "https://github.com/sponsors/gschier"
   }
  ],
  "notes": {
   "type": "github_release",
   "repo": "mountain-loop/yaak"
  }
 },
 "release": {
  "branch": "main",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "YAAK_RELEASE",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 3001,
   "scheme": "https",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Yaak desktop gui (for reverse proxy only)."
   },
   {
    "internal": "3001",
    "description": "Yaak desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/yaak/config",
    "description": "Where yaak should store its config and data."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Programming"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/yaak-logo.png",
  "setup": "This image sets up the Yaak desktop app and makes its interface available in the browser. The interface is available at `https://your-ip:3001`.\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-04-20",
   "text": "Rebase to resolute."
  },
  {
   "date": "2026-04-04",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2026-03-11",
   "text": "Push aarch64 image. Update external trigger."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-07-29",
   "text": "Rebase to selkies. Breaking Change: HTTPS is now required. Either use a reverse proxy with SSL cert or direct connect to port 8181 with HTTPS."
  },
  {
   "date": "2024-09-12",
   "text": "Initial release."
  }
 ]
}
