{
 "schema": 1,
 "name": "minisatip",
 "summary": "[Minisatip](https://github.com/catalinii/minisatip) is a multi-threaded satip server version 1.2 that runs under Linux and it was tested with DVB-S, DVB-S2, DVB-T, DVB-T2, DVB-C, DVB-C2, ATSC and ISDB-T cards.",
 "upstream": {
  "url": "https://github.com/catalinii/minisatip",
  "version": {
   "type": "github_release",
   "repo": "catalinii/minisatip"
  },
  "notes": {
   "type": "github_release",
   "repo": "catalinii/minisatip"
  },
  "sponsor": [
   {
    "name": "minisatip",
    "url": "https://paypal.me/minisatip"
   },
   {
    "name": "minisatip (GitHub Sponsors)",
    "url": "https://github.com/sponsors/catalinii"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "ubuntu",
  "version_arg": "MINISATIP_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 8875
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "8875",
    "description": "Status Page WebUI"
   },
   {
    "internal": "554",
    "description": "RTSP Port"
   },
   {
    "internal": "1900/udp",
    "description": "App Discovery"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/minisatip/config",
    "description": "Configuration files and minisatip data"
   }
  ],
  "env": [
   {
    "name": "RUN_OPTS",
    "value": "",
    "description": "Specify specific run params for minisatip"
   }
  ],
  "devices": [
   {
    "path": "/dev/dvb",
    "description": "For passing through Tv-cards"
   }
  ]
 },
 "docs": {
  "categories": [
   "Media Tools"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/minisatip-icon.png",
  "setup": "Best used in conjunction with [tvheadend](https://github.com/linuxserver/docker-tvheadend)\n\nThere is no setup per se, other than adding your cards for passthrough.\n\nYou can then use your cards as DVB inputs in apps such as tvheadend.\n"
 },
 "proxy": {
  "port": 8875,
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
