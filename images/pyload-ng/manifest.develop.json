{
 "schema": 1,
 "name": "pyload-ng",
 "summary": "[pyLoad](https://pyload.net/) is a Free and Open Source download manager written in Python and designed to be extremely lightweight, easily extensible and fully manageable via web.",
 "upstream": {
  "url": "https://pyload.net/",
  "version": {
   "type": "github_commit",
   "repo": "pyload/pyload",
   "branch": "develop"
  },
  "notes": {
   "type": "github_commit",
   "repo": "pyload/pyload",
   "branch": "develop"
  },
  "sponsor": [
   {
    "name": "pyLoad",
    "url": "https://PayPal.Me/nitzo2001/0usd"
   }
  ]
 },
 "release": {
  "branch": "develop",
  "tag": "develop",
  "channel": "prerelease",
  "tags": [
   {
    "tag": "latest",
    "description": "Stable releases from pyLoad Next"
   },
   {
    "tag": "develop",
    "description": "Releases from pyload Next develop branch"
   }
  ]
 },
 "build": {
  "base": "alpine",
  "version_arg": "PYLOAD_COMMIT",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 8000
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "8000",
    "description": "Allows HTTP access to the application"
   },
   {
    "internal": "9666",
    "description": "Click'n'Load port.",
    "optional": true
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/pyload-ng/config",
    "description": "Persistent config files"
   },
   {
    "path": "/downloads",
    "host_path": "/path/to/downloads",
    "description": "Destination of pyLoad downloads"
   }
  ]
 },
 "docs": {
  "categories": [
   "Downloaders"
  ],
  "logo": "https://github.com/linuxserver/docker-templates/raw/master/linuxserver.io/img/pyload-logo.png",
  "setup": "Access the web interface at `http://your-ip:8000` the default login is:\nusername - **pyload**\npassword - **pyload**\n\nFor general usage please see the pyLoad wiki [here](https://github.com/pyload/pyload/wiki) .\n"
 },
 "proxy": {
  "port": 8000,
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
