tenv bash\n# shellcheck shell=bash\n\n#Check to make sure the subdomain and token are set\nif [ -z \"${SUBDOMAINS}\" ] || [ -z \"${TOKEN}\" ]; then\n    echo \"Please pass both your subdomain(s) and token as environment variables in your docker run command. See the readme for more details.\"\n    sleep infinity\nfi\n\nif [[ ! -f /config/logrotate.conf ]]; then\n    cp /defaults/logrotate.conf /config/logrotate.conf\n    chmod 640 /config/logrotate.conf\nfi\n\n# permissions\nlsiown -R abc:abc \\\n    /config\n\n# run initial IP update\nexec \\\n    s6-setuidgid abc /app/duck.sh\n"},{"name":"init-envfile","type":"oneshot","depends_on":[],"source":"base"},{"name":"init-migrations","type":"oneshot","depends_on":[],"source":"base"},{"name":"init-mods","type":"oneshot","depends_on":["init-config-end"],"source":"base"},{"name":"init-mods-end","type":"oneshot","depends_on":["init-mods-package-install"],"source":"base"},{"name":"init-mods-package-install","type":"oneshot","depends_on":["init-mods"],"source":"base"},{"name":"init-os-end","type":"oneshot","depends_on":["init-adduser","init-device-perms","init-envfile"],"source":"base"},{"name":"init-services","type":"oneshot","depends_on":["init-custom-files"],"source":"base"},{"name":"svc-cron","type":"longrun","depends_on":["init-services"],"source":"base"},{"name":"user","type":"bundle","depends_on":[],"source":"base"},{"name":"user2","type":"bundle","depends_on":[],"source":"base"}],"d2":"\"duckdns:latest\": {\n  docker-mods\n  base {\n    fix-attr +\\nlegacy cont-init\n  }\n  docker-mods -> base\n  legacy-services\n  custom services\n  init-services -> legacy-services\n  init-services -> custom services\n  custom services -> legacy-services\n  legacy-services -> ci-service-check\n  init-migrations -> init-adduser\n  init-os-end -> init-config\n  init-config -> init-config-end\n  init-crontab-config -> init-config-end\n  init-duckdns -> init-config-end\n  init-config -> init-crontab-config\n  init-mods-end -> init-custom-f