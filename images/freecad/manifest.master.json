{
 "schema": 1,
 "name": "freecad",
 "summary": "[FreeCAD](https://www.freecad.org/) is a general-purpose parametric 3D computer-aided design (CAD) modeler and a building information modeling (BIM) software application with finite element method (FEM) support.",
 "upstream": {
  "url": "https://www.freecad.org/",
  "version": {
   "type": "github_release",
   "repo": "FreeCAD/FreeCAD",
   "require_assets": [
    {
     "asset": "Linux-x86_64-py311\\.AppImage$"
    },
    {
     "asset": "Linux-aarch64-py311\\.AppImage$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "FreeCAD/FreeCAD"
  },
  "sponsor": [
   {
    "name": "FreeCAD",
    "url": "https://wiki.freecad.org/Donate"
   },
   {
    "name": "FreeCAD (GitHub Sponsors)",
    "url": "https://github.com/sponsors/FreeCAD"
   },
   {
    "name": "FreeCAD (Open Collective)",
    "url": "https://opencollective.com/freecad"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "FREECAD_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "FreeCAD desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "FreeCAD desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and files."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "3D Modeling"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/freecad-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-29",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-09-22",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2025-07-02",
   "text": "Rebase to Selkies, HTTPS is now required! Ingest from current appimage."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon."
  },
  {
   "date": "2023-12-06",
   "text": "Initial release."
  }
 ]
}
