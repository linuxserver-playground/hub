{
 "schema": 1,
 "name": "kicad",
 "summary": "[KiCad](https://www.kicad.org/) - A Cross Platform and Open Source Electronics Design Automation Suite.",
 "upstream": {
  "url": "https://www.kicad.org/",
  "version": {
   "type": "alpine_apk",
   "repo_url": "http://dl-cdn.alpinelinux.org/alpine/v3.24/community/",
   "package": "kicad"
  },
  "notes": {
   "type": "github_release",
   "repo": "KiCad/kicad-source-mirror",
   "transform": [
    {
     "regex": "-r\\d+$",
     "replace": ""
    }
   ]
  },
  "sponsor": [
   {
    "name": "KiCad donate",
    "url": "https://www.kicad.org/donate/"
   },
   {
    "name": "KiCad on Linux Foundation crowdfunding",
    "url": "https://crowdfunding.linuxfoundation.org/projects/kicad"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "KICAD_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "KiCad desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "KiCad desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and files."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "3D Modeling"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/kicad-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n\n**A text editor is available in this image under /usr/bin/mousepad**\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-06-10",
   "text": "Rebase to Alpine 3.24."
  },
  {
   "date": "2026-03-29",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic, rebase to Alpine 3.23."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies and Alpine 3.22, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-12-06",
   "text": "Rebase to Alpine 3.21."
  },
  {
   "date": "2024-05-23",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon."
  },
  {
   "date": "2023-12-06",
   "text": "Initial release."
  }
 ]
}
