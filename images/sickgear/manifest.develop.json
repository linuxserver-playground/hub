{
 "schema": 1,
 "name": "sickgear",
 "summary": "[SickGear](https://github.com/sickgear/sickgear) provides management of TV shows and/or Anime, it detects new episodes, links downloader apps, and more..\n\nFor more information on SickGear visit their website and check it out: https://github.com/SickGear/SickGear",
 "upstream": {
  "url": "https://github.com/sickgear/sickgear",
  "version": {
   "type": "github_commit",
   "repo": "sickgear/sickgear",
   "branch": "dev"
  },
  "notes": {
   "type": "github_commit",
   "repo": "sickgear/sickgear",
   "branch": "dev"
  }
 },
 "release": {
  "branch": "develop",
  "tag": "develop",
  "channel": "prerelease",
  "tags": [
   {
    "tag": "latest",
    "description": "Stable SickGear releases"
   },
   {
    "tag": "develop",
    "description": "SickGear develop branch commits"
   }
  ]
 },
 "build": {
  "base": "alpine",
  "version_arg": "SICKGEAR_RELEASE",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "web": {
   "port": 8081,
   "path": "/home/view-changes"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "8081",
    "description": "will map the container's port 8081 to port 8081 on the host"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/sickgear/data",
    "description": "Persistent config files."
   },
   {
    "path": "/tv",
    "host_path": "/path/to/tv",
    "description": "where you store your tv shows"
   },
   {
    "path": "/downloads",
    "host_path": "/path/to/downloads",
    "description": "your downloads folder for post processing (must not be download in progress)"
   }
  ]
 },
 "docs": {
  "categories": [
   "Media Management"
  ],
  "logo": "https://raw.githubusercontent.com/wiki/SickGear/SickGear.Wiki/images/SickGearLogo.png",
  "setup": "## Setting up the application\n\nAccess the webui at `<your-ip>:8081`, for more information check out [SickGear](https://github.com/sickgear/sickgear).\n"
 },
 "proxy": {
  "port": 8081,
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
