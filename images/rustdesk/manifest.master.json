{
 "schema": 1,
 "name": "rustdesk",
 "summary": "[RustDesk](https://rustdesk.com/) is a full-featured open source remote control alternative for self-hosting and security with minimal configuration.",
 "upstream": {
  "url": "https://rustdesk.com/",
  "version": {
   "type": "github_release",
   "repo": "rustdesk/rustdesk"
  },
  "notes": {
   "type": "github_release",
   "repo": "rustdesk/rustdesk"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "RUSTDESK_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "HTTP RustDesk desktop gui, must be proxied."
   },
   {
    "internal": "3001",
    "description": "HTTPS Rustdesk desktop gui."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores local files and settings"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Remote Desktop"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/rustdesk-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n\n**Note: This is the Desktop application in a web accessible format! This container is for running the client in a sandbox so it does not have access to your system. It is not a server solution!**\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-04-04",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-09-22",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-07-25",
   "text": "Initial release."
  }
 ]
}
