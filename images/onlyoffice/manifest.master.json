{
 "schema": 1,
 "name": "onlyoffice",
 "summary": "[ONLYOFFICE](https://www.onlyoffice.com/) provides a full range of tools to create, edit and collaborate on text documents, spreadsheets, presentations, PDF forms and regular PDF files on web, desktop and mobile platforms.",
 "upstream": {
  "url": "https://www.onlyoffice.com/",
  "version": {
   "type": "github_release",
   "repo": "ONLYOFFICE/DesktopEditors",
   "require_assets": [
    {
     "asset": "^onlyoffice\\-desktopeditors_amd64\\.deb$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "ONLYOFFICE/DesktopEditors"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "ONLYOFFICE_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "ONLYOFFICE desktop gui, must be proxied."
   },
   {
    "internal": "3001",
    "description": "ONLYOFFICE desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores program settings and documents"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "This is needed for ONLYOFFICE to function properly."
   }
  ]
 },
 "docs": {
  "categories": [
   "Documents"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/onlyoffice-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-29",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-08-08",
   "text": "Initial release."
  }
 ]
}
