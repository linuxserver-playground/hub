 \\\n  if [ -z ${ONLYOFFICE_VERSION+x} ]; then \\\n    ONLYOFFICE_VERSION=$(curl -sX GET \"https://api.github.com/repos/ONLYOFFICE/DesktopEditors/releases/latest\" \\\n    | jq -r '.tag_name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/onlyoffice.deb -L \\\n    \"https://github.com/ONLYOFFICE/DesktopEditors/releases/download/${ONLYOFFICE_VERSION}/onlyoffice-desktopeditors_amd64.deb\" && \\\n  apt-get update && \\\n  apt-get install -y \\\n    gsettings-desktop-schemas \\\n    /tmp/onlyoffice.deb && \\\n  echo \"**** cleanup ****\" && \\\n  apt-get clean && \\\n  rm -rf \\\n    /tmp/* \\\n    /var/lib/apt/lists/* \\\n    /var/tmp/*\n\n# add local files\nCOPY /root /\n\n# ports and volumes\nEXPOSE 3001\n\nVOLUME /config\n"},"test":{"enabled":true,"success":true,"per_arch":{"amd64":true},"report_url":"https://linuxserver-playground.github.io/site/images/onlyoffice/builds/v10.0.0-ls7/"},"assets":[{"name":"packages.amd64.json.gz","size":293881,"sha256":"18b59b4e649e97822431284f16b2a873bdd010c1b0089266d447bf6c9055a1db","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls7/packages.amd64.json.gz"},{"name":"layers.amd64.json","size":17284,"sha256":"499fa3e625ee708604d6ca659d6e78ad9cdc1333adb5962a5ca4868c573a33e8","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls7/layers.amd64.json"},{"name":"files.amd64.json.gz","size":399949,"sha256":"2f99483e72d8936fa440123b85dd2dc73126d01176b356a25219f5112291b409","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls7/files.amd64.json.gz"},{"name":"test.amd64.json","size":2917,"sha256":"e4f7bc5d1e2fcf43ba4a6458a05a1a3e08dab5d79a4dc3978cc2b4e7e886e614","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls7/test.amd64.json"},{"name":"test.amd64.tar.gz","size":81784,"sha256":"884164cba2d5f5d8bbbbeb210a9ecabc850f38db38eef4b54dda7c456df44cb0","url":"https://github.com/linuxse