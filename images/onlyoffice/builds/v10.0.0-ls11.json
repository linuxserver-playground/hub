*\" && \\\n  if [ -z ${ONLYOFFICE_VERSION+x} ]; then \\\n    ONLYOFFICE_VERSION=$(curl -sX GET \"https://api.github.com/repos/ONLYOFFICE/DesktopEditors/releases/latest\" \\\n    | jq -r '.tag_name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/onlyoffice.deb -L \\\n    \"https://github.com/ONLYOFFICE/DesktopEditors/releases/download/${ONLYOFFICE_VERSION}/onlyoffice-desktopeditors_amd64.deb\" && \\\n  apt-get update && \\\n  apt-get install -y \\\n    gsettings-desktop-schemas \\\n    /tmp/onlyoffice.deb && \\\n  echo \"**** cleanup ****\" && \\\n  apt-get clean && \\\n  rm -rf \\\n    /tmp/* \\\n    /var/lib/apt/lists/* \\\n    /var/tmp/*\n\n# add local files\nCOPY /root /\n\n# ports and volumes\nEXPOSE 3001\n\nVOLUME /config\n"},"test":{"enabled":true,"success":true,"per_arch":{"amd64":true},"report_url":"https://linuxserver-playground.github.io/site/images/onlyoffice/builds/v10.0.0-ls11/"},"assets":[{"name":"packages.amd64.json.gz","size":294215,"sha256":"c87b2920f09c8db236db369a7038f9c11eee3cf54ad6aca710d98d976ed207f9","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls11/packages.amd64.json.gz"},{"name":"layers.amd64.json","size":17285,"sha256":"96c7d40fdb07641d2412aaf0cef9ee37a4e487f9472e395bf3918814d315ddde","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls11/layers.amd64.json"},{"name":"files.amd64.json.gz","size":400167,"sha256":"304e761ac59876d2636bfafc96d00df13c92d704eaef919d213756a202bae455","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls11/files.amd64.json.gz"},{"name":"test.amd64.json","size":2920,"sha256":"4ce0ec6f12875a59757a20a556e6d839160b7de4cb92e3ce62482b4829554781","url":"https://github.com/linuxserver-playground/docker-onlyoffice/releases/download/v10.0.0-ls11/test.amd64.json"},{"name":"test.amd64.tar.gz","size":81877,"sha256":"a191fa5949b658558ee64061bc00700baadf2c1ab4a8254500be174a5f09947f","url":"https://github.