   },
   {
    "tag": "ubuntu-xfce",
    "description": "XFCE Ubuntu *Wayland Support",
    "deprecated": false
   },
   {
    "tag": "dev",
    "description": "KDE Ubuntu *Current Selkies Development Head",
    "deprecated": false
   }
  ]
 },
 "build": {
  "base": "selkies",
  "version_arg": "XFCE_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 60,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Web Desktop GUI HTTP, must be proxied"
   },
   {
    "internal": "3001",
    "description": "Web Desktop GUI HTTPS"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/data",
    "description": "abc users home directory"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Remote Desktop"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/webtop-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
