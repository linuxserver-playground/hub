    "deprecated": false
   },
   {
    "tag": "debian-mate",
    "description": "MATE Debian",
    "deprecated": false
   },
   {
    "tag": "debian-xfce",
    "description": "XFCE Debian",
    "deprecated": false
   },
   {
    "tag": "fedora-i3",
    "description": "i3 Fedora *Wayland Support",
    "deprecated": false
   },
   {
    "tag": "fedora-kde",
    "description": "KDE Fedora *Wayland Support",
    "deprecated": false
   },
   {
    "tag": "fedora-mate",
    "description": "MATE Fedora",
    "deprecated": false
   },
   {
    "tag": "fedora-xfce",
    "description": "XFCE Fedora",
    "deprecated": false
   },
   {
    "tag": "ubuntu-i3",
    "description": "i3 Ubuntu *Wayland Support",
    "deprecated": false
   },
   {
    "tag": "ubuntu-kde",
    "description": "KDE Ubuntu *Wayland Support"
   },
   {
    "tag": "ubuntu-lxqt",
    "description": "LXQt Ubuntu *Wayland Support",
    "deprecated": false
   },
   {
    "tag": "ubuntu-mate",
    "description": "MATE Ubuntu",
