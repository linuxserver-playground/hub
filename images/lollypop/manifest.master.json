{
 "schema": 1,
 "name": "lollypop",
 "summary": "[Lollypop](https://wiki.gnome.org/Apps/Lollypop) is a lightweight modern music player designed to work excellently on the GNOME desktop environment.",
 "upstream": {
  "url": "https://wiki.gnome.org/Apps/Lollypop",
  "version": {
   "type": "alpine_apk",
   "repo_url": "http://dl-cdn.alpinelinux.org/alpine/v3.24/community/",
   "package": "lollypop"
  },
  "sponsor": [
   {
    "name": "Patreon (Cédric Bellegarde, gnumdk)",
    "url": "https://www.patreon.com/gnumdk"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "LOLLYPOP_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Lollypop desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Lollypop desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores settings and downloaded metadata for music."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Music"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/lollypop-icon.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-06-10",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false, rebase to Alpine 3.24."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic, rebase to Alpine 3.23."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies and Alpine 3.22, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-12-06",
   "text": "Rebase to Alpine 3.21."
  },
  {
   "date": "2024-05-23",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon."
  },
  {
   "date": "2024-01-21",
   "text": "Rebase to Alpine 3.19."
  },
  {
   "date": "2023-04-21",
   "text": "Initial release."
  }
 ]
}
