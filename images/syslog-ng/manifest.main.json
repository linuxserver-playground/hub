{
 "schema": 1,
 "name": "syslog-ng",
 "summary": "[syslog-ng](https://www.syslog-ng.com/products/open-source-log-management/) allows you to flexibly collect, parse, classify, rewrite and correlate logs from across your infrastructure and store or route them to log analysis tools.",
 "upstream": {
  "url": "https://www.syslog-ng.com/products/open-source-log-management/",
  "version": {
   "type": "alpine_apk",
   "repo_url": "http://dl-cdn.alpinelinux.org/alpine/v3.24/main/",
   "package": "syslog-ng"
  },
  "notes": {
   "type": "github_release",
   "repo": "syslog-ng/syslog-ng",
   "tag": "syslog-ng-${VERSION}",
   "transform": [
    {
     "regex": "-r\\d+$",
     "replace": ""
    }
   ]
  }
 },
 "release": {
  "branch": "main",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "alpine",
  "version_arg": "SYSLOG_NG_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120
 },
 "runtime": {
  "ports": [
   {
    "internal": "5514/udp",
    "external": "514",
    "description": "Syslog UDP"
   },
   {
    "internal": "6601/tcp",
    "external": "601",
    "description": "Syslog TCP"
   },
   {
    "internal": "6514/tcp",
    "description": "Syslog TLS"
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/syslog-ng/config",
    "description": "Stores config and application files"
   },
   {
    "path": "/var/log",
    "host_path": "/path/to/log",
    "description": "Stores logs collected by the syslog-ng service",
    "optional": true
   }
  ],
  "env": [
   {
    "name": "LOG_TO_STDOUT",
    "value": "",
    "description": "If set to `true` container will log to stdout, otherwise will log to `/config/log/`.",
    "optional": true
   }
  ],
  "readonly": {
   "supported": true
  },
  "nonroot": {
   "supported": true
  }
 },
 "docs": {
  "categories": [
   "Monitoring"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/syslog-ng-logo.png",
  "setup": "Edit `/config/syslog-ng.conf` to configure your logging sources and destinations.\n\nThe application pid, control file, etc. are all kept in /config so when using tools such as `syslog-ng-ctl` you need to specify the path e.g. `syslog-ng-ctl reload -c /config/syslog-ng.ctl`\n\nMore info at [syslog-ng](https://www.syslog-ng.com/technical-documents/list/syslog-ng-open-source-edition).\n"
 },
 "changelog": [
  {
   "date": "2026-07-05",
   "text": "Rebase to Alpine 3.24."
  },
  {
   "date": "2025-12-26",
   "text": "Rebase to Alpine 3.23."
  },
  {
   "date": "2025-07-05",
   "text": "Rebase to Alpine 3.22."
  },
  {
   "date": "2024-12-20",
   "text": "Rebase to Alpine 3.21."
  },
  {
   "date": "2024-09-24",
   "text": "Add opt to log to stdout."
  },
  {
   "date": "2024-05-24",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-01-31",
   "text": "Rebase to Alpine 3.19."
  },
  {
   "date": "2023-06-11",
   "text": "Rebase to Alpine 3.18, deprecate armhf."
  },
  {
   "date": "2023-01-10",
   "text": "Add paho-mqtt-c library as required by the syslog-ng documentation"
  },
  {
   "date": "2022-12-30",
   "text": "Rebase to Alpine 3.17, add libdbi-drivers for SQL support."
  },
  {
   "date": "2022-10-01",
   "text": "Rebase to Alpine 3.16, migrate to s6v3."
  },
  {
   "date": "2021-12-18",
   "text": "Rebase to Alpine 3.15."
  },
  {
   "date": "2021-07-01",
   "text": "Rebase to Alpine 3.14."
  },
  {
   "date": "2021-05-26",
   "text": "Initial release."
  }
 ]
}
