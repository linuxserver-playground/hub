{
 "schema": 1,
 "name": "adguardhome-sync",
 "summary": "[Adguardhome-sync](https://github.com/bakito/adguardhome-sync/) is a tool to synchronize AdGuardHome config to replica instances.",
 "upstream": {
  "url": "https://github.com/bakito/adguardhome-sync/",
  "version": {
   "type": "github_release",
   "repo": "bakito/adguardhome-sync",
   "require_assets": [
    {
     "asset": "^adguardhome\\-sync_.*_linux_amd64\\.tar\\.gz$"
    },
    {
     "asset": "^adguardhome\\-sync_.*_linux_arm64\\.tar\\.gz$"
    }
   ]
  },
  "notes": {
   "type": "github_release",
   "repo": "bakito/adguardhome-sync"
  },
  "sponsor": [
   {
    "name": "AdGuardHome Sync",
    "url": "https://github.com/sponsors/bakito"
   }
  ]
 },
 "release": {
  "branch": "main",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "alpine",
  "version_arg": "ADGUARDHOMESYNC_RELEASE",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 60
 },
 "runtime": {
  "ports": [
   {
    "internal": "8080",
    "description": "Port for AdGuardHome Sync's web API."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/adguardhome-sync/config",
    "description": "Contains all relevant configuration files."
   }
  ],
  "env": [
   {
    "name": "CONFIGFILE",
    "value": "/config/adguardhome-sync.yaml",
    "description": "Set a custom config file.",
    "optional": true
   }
  ],
  "readonly": {
   "supported": true
  },
  "nonroot": {
   "supported": true
  }
 },
 "docs": {
  "categories": [
   "Network",
   "DNS"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/adguardhomesync-icon.png",
  "setup": "Edit the adguardhome-sync.yaml with your AdGuardHome instance details, for more information check out [AdGuardHome Sync](https://github.com/bakito/adguardhome-sync/).\n"
 },
 "changelog": [
