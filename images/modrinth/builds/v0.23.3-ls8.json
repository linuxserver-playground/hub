\n    MODRINTH_VERSION=$(curl -sX GET \"https://api.github.com/repos/modrinth/code/releases/latest\" \\\n    | jq -r '.tag_name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/modrinth.deb -L \\\n    \"https://launcher-files.modrinth.com/versions/$(echo ${MODRINTH_VERSION}| sed 's/^v//g')/linux/Modrinth%20App_$(echo ${MODRINTH_VERSION}| sed 's/^v//g')_amd64.deb\" && \\\n  apt-get install -y \\\n    /tmp/modrinth.deb && \\\n  echo \"**** cleanup ****\" && \\\n  apt-get autoclean && \\\n  rm -rf \\\n    /config/.cache \\\n    /var/lib/apt/lists/* \\\n    /var/tmp/* \\\n    /tmp/*\n\n# add local files\nCOPY /root /\n\n# ports and volumes\nEXPOSE 3001\nVOLUME /config\n"},"test":{"enabled":true,"success":true,"per_arch":{"amd64":true},"report_url":"https://linuxserver-playground.github.io/site/images/modrinth/builds/v0.23.3-ls8/"},"assets":[{"name":"packages.amd64.json.gz","size":309638,"sha256":"ae9f36fea02d0f7a76f097e7befbcec899a598ccb55ae21c3f37e16e75c6fdcf","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls8/packages.amd64.json.gz"},{"name":"layers.amd64.json","size":16631,"sha256":"3d8b3b13a913c9604daedb10be04d5c1a8539d1241b8b7341cf105de1fa09cac","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls8/layers.amd64.json"},{"name":"files.amd64.json.gz","size":387281,"sha256":"e743cdaabbffa843279b3cf59841dab39ff86fe42b86eee78290d6727283bcc3","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls8/files.amd64.json.gz"},{"name":"test.amd64.json","size":2901,"sha256":"b7871845eabdf4fe3659dcf0207b028667123bd9ef6a105b001e0acef35335c4","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls8/test.amd64.json"},{"name":"test.amd64.tar.gz","size":310861,"sha256":"8229cd452fb6b07992f244dbc36e0fa6babafcf9c1eed5bd83a6cea427c91ae2","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls8/test.a