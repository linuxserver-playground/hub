\n    MODRINTH_VERSION=$(curl -sX GET \"https://api.github.com/repos/modrinth/code/releases/latest\" \\\n    | jq -r '.tag_name'); \\\n  fi && \\\n  curl -o \\\n    /tmp/modrinth.deb -L \\\n    \"https://launcher-files.modrinth.com/versions/$(echo ${MODRINTH_VERSION}| sed 's/^v//g')/linux/Modrinth%20App_$(echo ${MODRINTH_VERSION}| sed 's/^v//g')_amd64.deb\" && \\\n  apt-get install -y \\\n    /tmp/modrinth.deb && \\\n  echo \"**** cleanup ****\" && \\\n  apt-get autoclean && \\\n  rm -rf \\\n    /config/.cache \\\n    /var/lib/apt/lists/* \\\n    /var/tmp/* \\\n    /tmp/*\n\n# add local files\nCOPY /root /\n\n# ports and volumes\nEXPOSE 3001\nVOLUME /config\n"},"test":{"enabled":true,"success":true,"per_arch":{"amd64":true},"report_url":"https://linuxserver-playground.github.io/site/images/modrinth/builds/v0.23.3-ls9/"},"assets":[{"name":"packages.amd64.json.gz","size":309765,"sha256":"b6a36919380d330f883c02018f39c675299b4fa70fc3ffccc733f67dbdafbdf2","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls9/packages.amd64.json.gz"},{"name":"layers.amd64.json","size":16631,"sha256":"6826cb2bb2d10cb8d0735ea7ee665949c68efcc8e04f9d0909491d183cb2037c","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls9/layers.amd64.json"},{"name":"files.amd64.json.gz","size":387275,"sha256":"99c63fbab31317768262b1038ae39367f4e5de7057ed02a68e78351895ec23bd","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls9/files.amd64.json.gz"},{"name":"test.amd64.json","size":2900,"sha256":"4f8dcc27c20b21c228ea8d8cc8f3922d44fa9db7d7e5b8050d47593411380ebe","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls9/test.amd64.json"},{"name":"test.amd64.tar.gz","size":309005,"sha256":"39e5329b8f3cb9383eae3e02c6b5d2445d48cf1d27bbe5bcd6a81d503e1497d7","url":"https://github.com/linuxserver-playground/docker-modrinth/releases/download/v0.23.3-ls9/test.a