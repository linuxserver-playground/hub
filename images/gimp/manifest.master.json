{
 "schema": 1,
 "name": "gimp",
 "summary": "[GIMP](https://www.gimp.org/) is a free and open-source raster graphics editor used for image manipulation (retouching) and image editing, free-form drawing, transcoding between different image file formats, and more specialized tasks. It is extensible by means of plugins, and scriptable.",
 "upstream": {
  "url": "https://www.gimp.org/",
  "version": {
   "type": "os"
  },
  "sponsor": [
   {
    "name": "GIMP donating page",
    "url": "https://www.gimp.org/donating/"
   },
   {
    "name": "GIMP on Liberapay",
    "url": "https://liberapay.com/GIMP/"
   }
  ]
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "debian",
  "version_arg": "GIMP_VERSION",
  "platforms": [
   "amd64",
   "arm64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "GIMP desktop gui HTTP, must be proxied."
   },
   {
    "internal": "3001",
    "description": "GIMP desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores local files and settings"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Image Editor"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/gimp-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-24",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies and Debian Trixie, install resynthesizer, HTTPS IS NOW REQUIRED."
  },
  {
   "date": "2024-12-06",
   "text": "Rebase to Alpine 3.21."
  },
  {
   "date": "2024-05-23",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-02-10",
   "text": "Update Readme with new env vars and ingest proper PWA icon."
  },
  {
   "date": "2023-12-07",
   "text": "Initial Release."
  }
 ]
}
