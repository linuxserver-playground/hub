{
 "schema": 1,
 "name": "webstation",
 "summary": "[Webstation](https://github.com/linuxserver/docker-webstation) is a web native emulation focused LXQt desktop based on Ubuntu.",
 "upstream": {
  "url": "https://github.com/linuxserver/docker-webstation",
  "version": {
   "type": "os"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable",
  "tags": [
   {
    "tag": "latest",
    "description": "Stable Webstation releases."
   },
   {
    "tag": "romm",
    "description": "romm-broker, the sidecar for collaborative streaming from the ROMM web interface."
   }
  ]
 },
 "build": {
  "base": "selkies",
  "version_arg": "OS_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "Webstation desktop gui HTTP must be proxied."
   },
   {
    "internal": "3001",
    "description": "Webstation desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores all files and games."
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Games"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/webstation-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n\n**This image should be run with a GPU**\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-09-23",
   "text": "Updates for selkies v2, add X11 support."
  },
  {
   "date": "2026-08-21",
   "text": "Add Xenia Edge emulator."
  },
  {
   "date": "2026-08-13",
   "text": "Add Azahar emulator."
  },
  {
   "date": "2026-08-10",
   "text": "Add Cemu emulator."
  },
  {
   "date": "2026-05-05",
   "text": "Rebase to resolute."
  },
  {
   "date": "2026-03-28",
   "text": "Swap UI to baked in selkies-desktop."
  },
  {
   "date": "2026-03-17",
   "text": "Fix eden ingestion to use self hosted git."
  },
  {
   "date": "2026-03-02",
   "text": "Fix init to not use session wrapper."
  },
  {
   "date": "2026-02-25",
   "text": "Initial Version."
  }
 ]
}
