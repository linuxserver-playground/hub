{
 "schema": 1,
 "name": "winegui",
 "summary": "[WineGUI](https://gitlab.melroy.org/melroy/winegui) is a user-interface friendly Wine manager that provides a graphical frontend for creating and managing Wine bottles.",
 "upstream": {
  "url": "https://gitlab.melroy.org/melroy/winegui",
  "version": {
   "type": "github_release",
   "repo": "winegui/WineGUI"
  },
  "notes": {
   "type": "github_release",
   "repo": "winegui/WineGUI"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "WINEGUI_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password",
   "screenshot_delay": 30
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "HTTP WineGUI, must be proxied."
   },
   {
    "internal": "3001",
    "description": "HTTPS WineGUI."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/winegui/config",
    "description": "Users home directory in the container, stores local files and settings"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop containers."
   }
  ]
 },
 "docs": {
  "categories": [
   "Games",
   "Business"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/winegui-logo.png",
  "setup": "The application can be accessed at:\n\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true,
    "nvidia": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-04-22",
   "text": "Initial release."
  }
 ]
}
