{
 "schema": 1,
 "name": "krita",
 "summary": "[Krita](https://krita.org/en/) is a professional FREE and open source painting program. It is made by artists that want to see affordable art tools for everyone.",
 "upstream": {
  "url": "https://krita.org/en/",
  "version": {
   "type": "regex",
   "url": "https://download.kde.org/stable/krita/updates/Krita-Stable-x86_64.appimage.zsync",
   "pattern": "^URL: https.*?krita-(.+?)-x86_64"
  }
 },
 "release": {
  "branch": "master",
  "tag": "latest",
  "channel": "stable"
 },
 "build": {
  "base": "selkies",
  "version_arg": "KRITA_VERSION",
  "platforms": [
   "amd64"
  ]
 },
 "test": {
  "startup_timeout": 120,
  "env": {
   "TZ": "US/Pacific"
  },
  "web": {
   "port": 3001,
   "scheme": "https",
   "auth": "user:password"
  }
 },
 "runtime": {
  "ports": [
   {
    "internal": "3000",
    "description": "HTTP Krita desktop gui, must be proxied."
   },
   {
    "internal": "3001",
    "description": "Krita desktop gui HTTPS."
   }
  ],
  "volumes": [
   {
    "path": "/config",
    "host_path": "/path/to/config",
    "description": "Users home directory in the container, stores local files and settings"
   }
  ],
  "custom": [
   {
    "flag": "shm-size",
    "compose": "shm_size",
    "value": "1gb",
    "description": "Recommended for all desktop images."
   }
  ]
 },
 "docs": {
  "categories": [
   "Image Editor"
  ],
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/krita-logo.png",
  "setup": "The application can be accessed at:\n\n* http://yourhost:3000/\n* https://yourhost:3001/\n",
  "notices": {
   "strict_proxy": true,
   "selkies": {
    "enabled": true
   }
  }
 },
 "proxy": {
  "port": 3001,
  "scheme": "https",
  "subdomain": true,
  "subfolder": {
   "supported": false
  }
 },
 "changelog": [
  {
   "date": "2026-03-29",
   "text": "Make Wayland default disable with PIXELFLUX_WAYLAND=false."
  },
  {
   "date": "2025-12-28",
   "text": "Add Wayland init logic."
  },
  {
   "date": "2025-09-22",
   "text": "Rebase to Debian Trixie."
  },
  {
   "date": "2025-07-12",
   "text": "Rebase to Selkies and Debian, use AppImage, HTTPS IS NOW REQUIRED. Remove arm64 support."
  },
  {
   "date": "2024-12-06",
   "text": "Rebase to Alpine 3.21."
  },
  {
   "date": "2024-05-23",
   "text": "Rebase to Alpine 3.20."
  },
  {
   "date": "2024-02-10",
   "text": "Rebase to Alpine 3.19, update Readme with new env vars, and ingest proper PWA icon."
  },
  {
   "date": "2023-12-07",
   "text": "Initial Release."
  }
 ]
}
