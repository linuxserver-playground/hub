{
  "cosmos-installer": {
    "form": [
      {
        "name": "HOST_URL",
        "label": "On initial setup this will be used to fill in the default admin configuration file in the /config directory, if unset the string HOSTURL will need to be replaced.",
        "initialValue": "IP or subdomain.domain.com",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/linuxserver-playground/sealskin:latest",
      "container_name": "{ServiceName}",
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "TZ=Etc/UTC",
        "HOST_URL={Context.HOST_URL}"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/sealskin-logo.png",
        "cosmos.stack": "{ServiceName}-sealskin"
      },
      "volumes": [
        {
          "source": "{ServiceName}-config",
          "target": "/config",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-storage",
          "target": "/storage",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-var-run-docker.sock",
          "target": "/var/run/docker.sock",
          "type": "volume"
        }
      ],
      "restart": "unless-stopped",
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8443",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
