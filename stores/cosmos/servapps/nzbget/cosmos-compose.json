{
  "cosmos-installer": {
    "form": [
      {
        "name": "NZBGET_USER",
        "label": "Specify the user for web authentication.",
        "initialValue": "nzbget",
        "type": "text"
      },
      {
        "name": "NZBGET_PASS",
        "label": "Specify the password for web authentication.",
        "initialValue": "tegbzn6789",
        "type": "password"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/linuxserver-playground/nzbget:latest",
      "container_name": "{ServiceName}",
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "TZ=Etc/UTC",
        "NZBGET_USER={Context.NZBGET_USER}",
        "NZBGET_PASS={Context.NZBGET_PASS}"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/nzbget-banner.png",
        "cosmos.stack": "{ServiceName}-nzbget"
      },
      "volumes": [
        {
          "source": "{ServiceName}-config",
          "target": "/config",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-downloads",
          "target": "/downloads",
          "type": "volume"
        }
      ],
      "restart": "unless-stopped",
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:6789",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
