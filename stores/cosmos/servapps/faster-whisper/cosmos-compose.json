{
  "cosmos-installer": {
    "form": [
      {
        "name": "DEBUG",
        "label": "If set to true, or any other value, the container will output debug logs.",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "LOCAL_ONLY",
        "label": "If set to true, or any other value, the container will not attempt to download models from HuggingFace and will only use locally-provided models.",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "WHISPER_BEAM",
        "label": "Number of candidates to consider simultaneously during transcription.",
        "initialValue": "1",
        "type": "text"
      },
      {
        "name": "WHISPER_LANG",
        "label": "Two character code for the language that you will speak to the add-on.",
        "initialValue": "auto",
        "type": "text"
      },
      {
        "name": "WHISPER_MODEL",
        "label": "Whisper model that will be used for transcription. From here.",
        "initialValue": "auto",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/linuxserver-playground/faster-whisper:latest",
      "container_name": "{ServiceName}",
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "TZ=Etc/UTC",
        "DEBUG={Context.DEBUG}",
        "LOCAL_ONLY={Context.LOCAL_ONLY}",
        "WHISPER_BEAM={Context.WHISPER_BEAM}",
        "WHISPER_LANG={Context.WHISPER_LANG}",
        "WHISPER_MODEL={Context.WHISPER_MODEL}"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "",
        "cosmos.stack": "{ServiceName}-faster-whisper"
      },
      "volumes": [
        {
          "source": "{ServiceName}-config",
          "target": "/config",
          "type": "volume"
        }
      ],
      "restart": "unless-stopped",
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:10300",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
