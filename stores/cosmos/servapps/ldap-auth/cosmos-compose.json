{
  "cosmos-installer": {
    "form": [
      {
        "name": "FERNETKEY",
        "label": "Optionally define a custom valid fernet key (only needed if container is frequently recreated, or if using multi-node setups, invalidating previous authentications)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "CERTFILE",
        "label": "Optionally point this to a certificate file to enable HTTP over SSL (HTTPS) for the ldap auth daemon",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "KEYFILE",
        "label": "Optionally point this to the private key file, matching the certificate file referred to in CERTFILE",
        "initialValue": "",
        "type": "password"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/linuxserver-playground/ldap-auth:latest",
      "container_name": "{ServiceName}",
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "TZ=Etc/UTC",
        "FERNETKEY={Context.FERNETKEY}",
        "CERTFILE={Context.CERTFILE}",
        "KEYFILE={Context.KEYFILE}"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/ldap-auth-logo.png",
        "cosmos.stack": "{ServiceName}-ldap-auth"
      },
      "volumes": [],
      "restart": "unless-stopped",
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8888",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
