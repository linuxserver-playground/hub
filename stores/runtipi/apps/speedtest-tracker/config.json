{
  "name": "Speedtest-tracker",
  "available": true,
  "exposable": true,
  "port": 80,
  "id": "speedtest-tracker",
  "tipi_version": 1,
  "version": "v1.15.1",
  "categories": [
    "utilities"
  ],
  "description": "Speedtest-tracker is a self-hosted internet performance tracking application that runs speedtest checks against Ookla's Speedtest service.",
  "short_desc": "Speedtest-tracker is a self-hosted internet performance tracking application that runs speedtest checks against Ookla's ",
  "author": "linuxserver.io",
  "source": "https://github.com/linuxserver-playground/docker-speedtest-tracker",
  "website": "https://github.com/alexjustesen/speedtest-tracker",
  "logo_url": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/speedtest-tracker-logo.png",
  "form_fields": [
    {
      "type": "password",
      "label": "APP_KEY",
      "hint": "App key used for encrypting stored data. You can generate a key as per https://speedtest-tracker.dev",
      "required": true,
      "env_variable": "SPEEDTEST_TRACKER_APP_KEY"
    },
    {
      "type": "text",
      "label": "APP_URL",
      "hint": "The IP:port or URL your application will be accessed on (ie. http://192.168.1.1:6875 or https://bookstack.mydomain.com",
      "required": true,
      "env_variable": "SPEEDTEST_TRACKER_APP_URL"
    },
    {
      "type": "text",
      "label": "DB_CONNECTION",
      "hint": "Set the database type to use. sqlite, pgsql, or mysql",
      "required": true,
      "env_variable": "SPEEDTEST_TRACKER_DB_CONNECTION",
      "default": "sqlite"
    },
    {
      "type": "text",
      "label": "SPEEDTEST_SCHEDULE",
      "hint": "Set the test schedule in cron format. e.g. 0 /6",
      "required": true,
      "env_variable": "SPEEDTEST_TRACKER_SPEEDTEST_SCHEDULE"
    },
    {
      "type": "text",
      "label": "SPEEDTEST_SERVERS",
      "hint": "A comma-separated list of server IDs to test against. Run docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/speedtest-tracker:latest list-servers to get a list of nearby servers.",
      "required": true,
      "env_variable": "SPEEDTEST_TRACKER_SPEEDTEST_SERVERS"
    },
    {
      "type": "text",
      "label": "DB_HOST",
      "hint": "Database hostname (postgres/mysql).",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DB_HOST"
    },
    {
      "type": "text",
      "label": "DB_PORT",
      "hint": "Database port (postgres/mysql).",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DB_PORT"
    },
    {
      "type": "text",
      "label": "DB_DATABASE",
      "hint": "Database name (postgres/mysql).",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DB_DATABASE"
    },
    {
      "type": "text",
      "label": "DB_USERNAME",
      "hint": "Database username (postgres/mysql).",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DB_USERNAME"
    },
    {
      "type": "password",
      "label": "DB_PASSWORD",
      "hint": "Database password (postgres/mysql).",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DB_PASSWORD"
    },
    {
      "type": "text",
      "label": "DISPLAY_TIMEZONE",
      "hint": "Timezone for the UI.",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_DISPLAY_TIMEZONE",
      "default": "Etc/UTC"
    },
    {
      "type": "text",
      "label": "PRUNE_RESULTS_OLDER_THAN",
      "hint": "Days to keep test results.",
      "required": false,
      "env_variable": "SPEEDTEST_TRACKER_PRUNE_RESULTS_OLDER_THAN",
      "default": "0"
    }
  ],
  "supported_architectures": [
    "amd64",
    "arm64"
  ],
  "dynamic_config": false
}
