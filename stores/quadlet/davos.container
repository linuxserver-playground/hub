# davos.container: generated by the hub from https://github.com/linuxserver-playground/docker-davos/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Davos (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/davos:latest
ContainerName=davos
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/davos/data:/config:Z
Volume=/path/to/downloads/folder:/download:Z
PublishPort=8080:8080

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
