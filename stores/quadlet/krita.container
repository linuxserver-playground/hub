# krita.container: generated by the hub from https://github.com/linuxserver-playground/docker-krita/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Krita (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/krita:latest
ContainerName=krita
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/config:/config:Z
PublishPort=3000:3000
PublishPort=3001:3001
ShmSize=1gb

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
