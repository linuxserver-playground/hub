# manyfold.container: generated by the hub from https://github.com/linuxserver-playground/docker-manyfold/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Manyfold (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/manyfold:latest
ContainerName=manyfold
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Environment=DATABASE_URL=
Environment=REDIS_URL=
Environment=SECRET_KEY_BASE=
Volume=/path/to/manyfold/config:/config:Z
# Volume=/path/to/libraries:/libraries:Z
PublishPort=3214:3214

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
