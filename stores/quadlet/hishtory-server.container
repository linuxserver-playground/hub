# hishtory-server.container: generated by the hub from https://github.com/linuxserver-playground/docker-hishtory-server/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Hishtory-server (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/hishtory-server:latest
ContainerName=hishtory-server
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
# Environment=HISHTORY_POSTGRES_DB=postgresql://${HISHTORY_DB_USER}:${HISHTORY_DB_PASS}@hishtory-db:5432/hishtory?sslmode=disable
# Environment=HISHTORY_SQLITE_DB=/config/hishtory.db
PublishPort=8080:8080

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
