# plex.container: generated by the hub from https://github.com/linuxserver-playground/docker-plex/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Plex (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/plex:latest
ContainerName=plex
AutoUpdate=registry
Network=host
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Environment=VERSION=docker
# Environment=PLEX_CLAIM=
Volume=/path/to/plex/library:/config:Z
Volume=/path/to/tvseries:/tv:Z
Volume=/path/to/movies:/movies:Z

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
