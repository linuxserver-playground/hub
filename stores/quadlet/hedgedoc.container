# hedgedoc.container: generated by the hub from https://github.com/linuxserver-playground/docker-hedgedoc/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Hedgedoc (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/hedgedoc:latest
ContainerName=hedgedoc
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Environment="DB_HOST=<hostname or ip>"
Environment=DB_PORT=3306
Environment=DB_USER=hedgedoc
Environment="DB_PASS=<secret password>"
Environment=DB_NAME=hedgedoc
Environment=CMD_DOMAIN=localhost
# Environment=CMD_URL_ADDPORT=false
# Environment=CMD_PROTOCOL_USESSL=false
# Environment=CMD_PORT=3000
# Environment=CMD_ALLOW_ORIGIN=['localhost']
# Environment=CMD_DB_DIALECT=
Volume=/path/to/hedgedoc/config:/config:Z
PublishPort=3000:3000

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
