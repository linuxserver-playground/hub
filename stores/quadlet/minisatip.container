# minisatip.container: generated by the hub from https://github.com/linuxserver-playground/docker-minisatip/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Minisatip (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/minisatip:latest
ContainerName=minisatip
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Environment=RUN_OPTS=
Volume=/path/to/minisatip/config:/config:Z
PublishPort=8875:8875
PublishPort=554:554
PublishPort=1900:1900/udp
AddDevice=/dev/dvb:/dev/dvb

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
