# nginx.container: generated by the hub from https://github.com/linuxserver-playground/docker-nginx/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Nginx (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/nginx:latest
ContainerName=nginx
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
# Environment=NGINX_AUTORELOAD=
# Environment=NGINX_AUTORELOAD_WATCHLIST=
Volume=/path/to/nginx/config:/config:Z
PublishPort=80:80
PublishPort=443:443

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
