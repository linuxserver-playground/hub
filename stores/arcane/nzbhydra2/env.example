# Nzbhydra2 for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where nzbhydra2 should store config data.
CONFIG_PATH=./config

# WebUI
PORT_5076=5076
