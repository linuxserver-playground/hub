# Tvheadend for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where TVHeadend show store it's config files.
CONFIG_PATH=./config

# Where you want the PVR to store recordings.
RECORDINGS_PATH=./recordings

# WebUI
PORT_9981=9981

# HTSP server port.
PORT_9982=9982
