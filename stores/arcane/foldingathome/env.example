# Foldingathome for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Register for an account on https://app.foldingathome.org and retrieve account token in settings. Required on first start.
ACCOUNT_TOKEN=

# Assign a friendly name to this instance (no spaces). Required on first start.
MACHINE_NAME=

# Where Folding@home should store its database and config.
CONFIG_PATH=./config
