# Luanti for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where luanti stores config files and maps etc.
CONFIG_MINETEST_PATH=./config/.minetest

# Port Luanti listens on (UDP).
PORT_30000_UDP=30000
