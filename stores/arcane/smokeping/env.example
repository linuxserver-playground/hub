# Smokeping for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Persistent config files
CONFIG_PATH=./config

# Storage location for db and application data (graphs etc)
DATA_PATH=./data

# Allows HTTP access to the internal webserver.
PORT_80=80
