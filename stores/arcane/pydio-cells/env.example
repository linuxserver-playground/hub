# Pydio-cells for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# The external url you would like to use to access Pydio Cells (Can be https://domain.url or https://IP:PORT).
EXTERNALURL=yourdomain.url

# All the config files reside here.
CONFIG_PATH=./config

# Http port
PORT_8080=8080
