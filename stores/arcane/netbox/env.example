# Netbox for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Email address for admin account
SUPERUSER_EMAIL=

# Password for admin account
SUPERUSER_PASSWORD=

# The hostname you will use to access the app (e.g., netbox.example.com)
ALLOWED_HOST=

# Database name (default: netbox)
DB_NAME=

# Database user
DB_USER=

# Database password
DB_PASSWORD=

# Database host (default: postgres)
DB_HOST=

# Database port (default: 5432)
DB_PORT=

# Redis host (default: redis)
REDIS_HOST=

# Redis port number (default: 6379)
REDIS_PORT=

# Redis username (default: none)
REDIS_USERNAME=

# Redis password (default: none)
REDIS_PASSWORD=

# Redis database ID for tasks (default: 0)
REDIS_DB_TASK=

# Redis database ID for caching (default: 1)
REDIS_DB_CACHE=

# Persistent config files
CONFIG_PATH=./config

# will map the container's port 8000 to port 8000 on the host
PORT_8000=8000
