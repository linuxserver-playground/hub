# Lazylibrarian for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# LazyLibrarian config
CONFIG_PATH=./config

# Download location
DOWNLOADS_PATH=./downloads

# The port for the LazyLibrarian webinterface
PORT_5299=5299
