# Syslog-ng for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Stores config and application files
CONFIG_PATH=./config

# Syslog UDP
PORT_5514_UDP=514

# Syslog TCP
PORT_6601_TCP=601

# Syslog TLS
PORT_6514_TCP=6514
