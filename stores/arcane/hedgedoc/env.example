# Hedgedoc for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Host address of mariadb database
DB_HOST=<hostname or ip>

# Port to access mariadb database default is 3306
DB_PORT=3306

# Database user
DB_USER=hedgedoc

# Database password
DB_PASS=

# Database name
DB_NAME=hedgedoc

# The address the gui will be accessed at (ie. 192.168.1.1 or hedgedoc.domain.com).
CMD_DOMAIN=localhost

# Persistent config files
CONFIG_PATH=./config

# Web gui port (internal port also needs to be changed if accessing at port other than 80, 443 and 3000).
PORT_3000=3000
