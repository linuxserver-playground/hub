# Yaak for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where yaak should store its config and data.
CONFIG_PATH=./config

# Yaak desktop gui (for reverse proxy only).
PORT_3000=3000

# Yaak desktop gui HTTPS.
PORT_3001=3001
