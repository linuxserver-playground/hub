# Lychee for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# DB type, from sqlite, mysql, pqsql.
DB_CONNECTION=

# DB server hostname. For mysql and pgsql only.
DB_HOST=

# DB server port. For mysql and pgsql only.
DB_PORT=

# DB user. For mysql and pgsql only.
DB_USERNAME=

# DB password. For mysql and pgsql only.
DB_PASSWORD=

# Path to DB file for sqlite. DB name for mysql and pgsql.
DB_DATABASE=

# Persistent config files.
CONFIG_PATH=./config

# Where lychee will store uploaded images.
PICTURES_PATH=./pictures

# http gui
PORT_80=80
