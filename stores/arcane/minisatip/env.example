# Minisatip for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Specify specific run params for minisatip
RUN_OPTS=

# Configuration files and minisatip data
CONFIG_PATH=./config

# Status Page WebUI
PORT_8875=8875

# RTSP Port
PORT_554=554

# App Discovery
PORT_1900_UDP=1900
