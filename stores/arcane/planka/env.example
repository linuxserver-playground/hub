# Planka for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# The URL you will use to access planka including protocol, and port if not 80/443.
BASE_URL=https://planka.example.com

# Postgres database URL. Special characters must be url encoded.
DATABASE_URL=postgresql://user:password@planka-db:5432/planka

# Email address for default user.
DEFAULT_ADMIN_EMAIL=demo@demo.demo

# Username for default user.
DEFAULT_ADMIN_USERNAME=demo

# Password for default user.
DEFAULT_ADMIN_PASSWORD=

# Display name for default user.
DEFAULT_ADMIN_NAME=Demo User

# Session encryption key, recommended 32-64 character alphanumeric.
SECRET_KEY=

# Set to true to trust upstream proxies if reverse proxying.
TRUST_PROXY=false

# Local path for planka config files.
CONFIG_PATH=./config

# Planka web UI.
PORT_1337=1337
