# Deluge for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# deluge configs
CONFIG_PATH=./config

# torrent download directory
DOWNLOADS_PATH=./downloads

# Port for webui
PORT_8112=8112

# Inbound torrent traffic (See App Setup)
PORT_6881=6881

# Inbound torrent traffic (See App Setup)
PORT_6881_UDP=6881
