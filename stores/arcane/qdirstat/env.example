# Qdirstat for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Users home directory in the container, stores qdirstat settings and scans.
CONFIG_PATH=./config

# Data you want to analyze disk usage information of.
DATA_PATH=./data

# QdirStat desktop gui HTTP, must be proxied.
PORT_3000=3000

# QdirStat desktop gui HTTPS.
PORT_3001=3001
