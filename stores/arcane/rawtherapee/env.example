# Rawtherapee for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# User's home directory in the container, stores program settings and files.
CONFIG_PATH=./config

# RawTherapee desktop gui (only for reverse proxy access).
PORT_3000=3000

# RawTherapee desktop gui HTTPS.
PORT_3001=3001
