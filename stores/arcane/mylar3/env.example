# Mylar3 for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Persistent config files
CONFIG_PATH=./config

# Map to your comics folder.
COMICS_PATH=./comics

# Map to your downloads folder.
DOWNLOADS_PATH=./downloads

# WebUI
PORT_8090=8090
