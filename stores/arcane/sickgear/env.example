# Sickgear for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Persistent configuration files.
CONFIG_PATH=./config

# where you store your tv shows
TV_PATH=./tv

# your downloads folder for post processing (must not be download in progress)
DOWNLOADS_PATH=./downloads

# will map the container's port 8081 to port 8081 on the host
PORT_8081=8081
