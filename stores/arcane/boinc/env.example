# Boinc for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where BOINC should store its database and config.
CONFIG_PATH=./config

# Boinc desktop gui HTTP (only to be used by reverse proxies and not direct access).
PORT_8080=8080

# Boinc desktop gui HTTPS.
PORT_8181=8181
