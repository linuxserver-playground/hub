# Qbittorrent for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# for changing the port of the web UI, see below for explanation
WEBUI_PORT=8080

# for changing the port of tcp/udp connection, see below for explanation
TORRENTING_PORT=6881

# Contains all relevant configuration files.
CONFIG_PATH=./config

# WebUI
PORT_8080=8080

# tcp connection port
PORT_6881=6881

# udp connection port
PORT_6881_UDP=6881
