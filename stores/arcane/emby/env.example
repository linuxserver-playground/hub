# Emby for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Emby data storage location. This can grow very large, 50gb+ is likely for a large collection.
CONFIG_PATH=./config

# Media goes here. Add as many as needed e.g. /data/movies, /data/tv, etc.
DATA_TVSHOWS_PATH=./data/tvshows

# Media goes here. Add as many as needed e.g. /data/movies, /data/tv, etc.
DATA_MOVIES_PATH=./data/movies

# Http webUI.
PORT_8096=8096
