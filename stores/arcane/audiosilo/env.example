# Audiosilo for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Persistent config files, database, backups and TLS certificates.
CONFIG_PATH=./config

# Audiobooks location, read-only (the server never writes to your books). Add it as a library in the admin console.
AUDIOBOOKS_RO_PATH=./audiobooks:ro

# Web player, admin console and the API the apps connect to.
PORT_8080=8080
