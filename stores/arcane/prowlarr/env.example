# Prowlarr for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Database and Prowlarr configs
CONFIG_PATH=./config

# The port for the Prowlarr web UI
PORT_9696=9696
