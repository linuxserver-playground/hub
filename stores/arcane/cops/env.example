# Cops for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# COPS Application Data.
CONFIG_PATH=./config

# Calibre metadata.db location.
BOOKS_PATH=./books

# HTTP WebUI
PORT_80=80

# HTTPS WebUI
PORT_443=443
