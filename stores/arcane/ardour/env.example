# Ardour for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Users home directory in the container, stores data and application config files.
CONFIG_PATH=./config

# Ardour desktop gui HTTP, must be proxied.
PORT_3000=3000

# Ardour desktop gui HTTPS.
PORT_3001=3001
