# Mame for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Users home directory in the container, stores local files and settings
CONFIG_PATH=./config

# MAME directory containing artwork, roms, and assets.
MAME_RO_PATH=./mame:ro

# HTTP MAME desktop gui, must be proxied.
PORT_3000=3000

# HTTPS MAME desktop gui.
PORT_3001=3001
