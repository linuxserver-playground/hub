# Transmission for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where transmission should store config files and logs.
CONFIG_PATH=./config

# WebUI
PORT_9091=9091

# Torrent Port TCP
PORT_51413=51413

# Torrent Port UDP
PORT_51413_UDP=51413
