# Flexget for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Set the FlexGet logging level.
FG_LOG_LEVEL=info

# Set the FlexGet log file location.
FG_LOG_FILE=/config/flexget.log

# Set the FlexGet config file location.
FG_CONFIG_FILE=/config/.flexget/config.yml

# Local path for FlexGet config files.
CONFIG_PATH=./config

# HTTP port for the WebUI.
PORT_5050=5050
