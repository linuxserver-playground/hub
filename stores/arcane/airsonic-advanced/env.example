# Airsonic-advanced for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Configuration file location.
CONFIG_PATH=./config

# Location of music.
MUSIC_PATH=./music

# Location for playlists to be saved to.
PLAYLISTS_PATH=./playlists

# Location of podcasts.
PODCASTS_PATH=./podcasts

# WebUI
PORT_4040=4040
