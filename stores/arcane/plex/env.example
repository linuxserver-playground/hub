# Plex for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Set whether to update plex or not - see Application Setup section.
VERSION=docker

# Plex library location. This can grow very large, 50gb+ is likely for a large collection.
CONFIG_PATH=./config

# Media goes here. Add as many as needed e.g. /movies, /tv, etc.
TV_PATH=./tv

# Media goes here. Add as many as needed e.g. /movies, /tv, etc.
MOVIES_PATH=./movies
