# Sealskin for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# All configuration files and metadata for the application.
CONFIG_PATH=./config

# All file storage for home directories and ephemeral mounts.
STORAGE_PATH=./storage

# Docker socket, required to spin up application containers.
VAR_RUN_DOCKER_SOCK_PATH=./var/run/docker.sock

# HTTPS Sessions and API communication port.
PORT_8443=8443
