# Syncthing for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Configuration files.
CONFIG_PATH=./config

# Data1
DATA1_PATH=./data1

# Data2
DATA2_PATH=./data2

# Application WebUI
PORT_8384=8384

# Listening port (TCP)
PORT_22000_TCP=22000

# Listening port (UDP)
PORT_22000_UDP=22000

# Protocol discovery
PORT_21027_UDP=21027
