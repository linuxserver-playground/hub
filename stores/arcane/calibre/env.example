# Calibre for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where calibre should store its database and library.
CONFIG_PATH=./config

# Calibre desktop gui (only for reverse proxy access).
PORT_8080=8080

# Calibre desktop gui HTTPS.
PORT_8181=8181

# Calibre webserver gui (needs to be enabled in gui settings first).
PORT_8081=8081
