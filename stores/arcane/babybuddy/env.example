# Babybuddy for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Add any address you'd like to access babybuddy at (comma separated, no spaces)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://babybuddy.domain.com

# Persistent config files
CONFIG_PATH=./config

# the port for the web ui
PORT_8000=8000
