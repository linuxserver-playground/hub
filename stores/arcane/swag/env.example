# Swag for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Top url you have control over (e.g. example.com if you own it, or customsubdomain.example.com if dynamic dns).
URL=example.com

# Certbot validation method to use, options are http or dns (dns method also requires DNSPLUGIN variable set).
VALIDATION=http

# Persistent config files
CONFIG_PATH=./config

# HTTPS port
PORT_443=443
