# Shotcut for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where Shotcut should store its config.
CONFIG_PATH=./config

# Shotcut desktop gui HTTP, must be proxied.
PORT_3000=3000

# Shotcut desktop gui HTTPS.
PORT_3001=3001
