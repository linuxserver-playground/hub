# Speedtest-tracker for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# App key used for encrypting stored data. You can generate a key as per https://speedtest-tracker.dev
APP_KEY=

# The IP:port or URL your application will be accessed on (ie. http://192.168.1.1:6875 or https://bookstack.mydomain.com
APP_URL=

# Set the database type to use. sqlite, pgsql, or mysql
DB_CONNECTION=sqlite

# Set the test schedule in cron format. e.g. 0 /6
SPEEDTEST_SCHEDULE=

# A comma-separated list of server IDs to test against. Run docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/speedtest-tracker:latest list-servers to get a list of nearby servers.
SPEEDTEST_SERVERS=

# Contains speedtest-tracker config and database, if using sqlite.
CONFIG_PATH=./config

# Web UI
PORT_80=80
