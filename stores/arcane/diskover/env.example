# Diskover for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# ElasticSearch host (optional)
ES_HOST=elasticsearch

# ElasticSearch port (optional)
ES_PORT=9200

# Persistent config files
CONFIG_PATH=./config

# Default mount point to crawl
DATA_PATH=./data

# diskover Web UI
PORT_80=80
