# Calibre-web for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where calibre-web stores the internal database and config.
CONFIG_PATH=./config

# Where your preexisting calibre database is located.
BOOKS_PATH=./books

# WebUI
PORT_8083=8083
