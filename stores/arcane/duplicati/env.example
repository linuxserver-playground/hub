# Duplicati for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Encryption key for settings database. Minimum 8 characters, alphanumeric.
SETTINGS_ENCRYPTION_KEY=

# Contains all relevant configuration files.
CONFIG_PATH=./config

# Path to store local backups.
BACKUPS_PATH=./backups

# Path to source for files to backup.
SOURCE_PATH=./source

# http gui
PORT_8200=8200
