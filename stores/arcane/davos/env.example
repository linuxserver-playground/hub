# Davos for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# davos's config location. This is where it stores its database file and logs.
CONFIG_PATH=./config

# davos's file download location
DOWNLOAD_PATH=./download

# This is the default port that davos runs under
PORT_8080=8080
