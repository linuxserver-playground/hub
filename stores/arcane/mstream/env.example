# Mstream for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# mStream config
CONFIG_PATH=./config

# Music location
MUSIC_PATH=./music

# The port for the mStream web interface
PORT_3000=3000
