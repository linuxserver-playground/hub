# Resilio-sync for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Where resilio-sync should store its config file.
CONFIG_PATH=./config

# Folder for downloads/cache.
DOWNLOADS_PATH=./downloads

# Sync folders root.
SYNC_PATH=./sync

# WebUI
PORT_8888=8888

# Sync Port.
PORT_55555=55555
