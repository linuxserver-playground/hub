# Ubooquity for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Config files and database for ubooquity.
CONFIG_PATH=./config

# Location of books.
BOOKS_PATH=./books

# Location of comics.
COMICS_PATH=./comics

# Location of raw files.
FILES_PATH=./files

# The library port.
PORT_2202=2202

# The admin port.
PORT_2203=2203
