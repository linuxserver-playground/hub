# Kimai for Arcane, generated by the LinuxServer.io hub from image.yml.

# User ID the app runs as; id youruser on the host shows yours.
PUID=1000

# Group ID the app runs as; id youruser on the host shows yours.
PGID=1000

# Timezone, as a tz database name such as Europe/London.
TZ=Etc/UTC

# Random string used for session encryption. Generate using e.g. openssl rand -hex 32.
APP_SECRET=

# Configure your database connection, see Application Setup instructions.
DATABASE_URL=mysql://your_db_user:your_db_pass@your_db_host:3306/your_db_name?charset=your_db_charset&serverVersion=your_db_version

# Domain or IP you will be using to access Kimai. Can be a regex like localhost|127.0.0.1|kimai.example.com
TRUSTED_HOSTS=kimai.example.com

# Persistent config files
CONFIG_PATH=./config

# http gui
PORT_80=80

# https gui
PORT_443=443
