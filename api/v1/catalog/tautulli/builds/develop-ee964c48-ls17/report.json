e":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-tautulli/compare/develop-9285bb16-ls16...develop-ee964c48-ls17","upstream":"Keep ALLOWALL selected after a settings page reload\n\nThe ALLOWALL option saves `*`, but the settings page selected it only\nwhen the saved value was `ALLOWALL`. After a reload the page showed\nSAMEORIGIN, and the next save wrote SAMEORIGIN over `*`.\n\nA blank value, which #2807 told users to set by hand, had the same\nproblem. It sends no header, same as `*`, so it now shows as ALLOWALL.\n\nFixes #2911\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","upstream_url":"https://github.com/Tautulli/Tautulli/commit/ee964c486f03ab31734a873c4d6ee26e667d5ace"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","TAUTULLI_DOCKER=True"],"exposed_ports":["8181/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17/layers.arm64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17/packages.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/tautulli/builds/develop-ee964c48-ls17/packages.arm64.json"},"release":"https://github.com/linuxserver-playground/d