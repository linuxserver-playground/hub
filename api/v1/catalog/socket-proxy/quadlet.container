# socket-proxy.container: generated by the hub from https://github.com/linuxserver-playground/docker-socket-proxy/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Socket-proxy (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/socket-proxy:latest
ContainerName=socket-proxy
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
