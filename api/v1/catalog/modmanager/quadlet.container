# modmanager.container: generated by the hub from https://github.com/linuxserver-playground/docker-modmanager/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Modmanager (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/modmanager:latest
ContainerName=modmanager
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
