# emby.container: generated by the hub from https://github.com/linuxserver-playground/docker-emby/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Emby (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/emby:latest
ContainerName=emby
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/emby/library:/config:Z
Volume=/path/to/tvshows:/data/tvshows:Z
Volume=/path/to/movies:/data/movies:Z
# Volume=/opt/vc/lib:/opt/vc/lib:Z
PublishPort=8096:8096
# PublishPort=8920:8920
# AddDevice=/dev/dri:/dev/dri
# AddDevice=/dev/video10:/dev/video10
# AddDevice=/dev/video11:/dev/video11
# AddDevice=/dev/video12:/dev/video12

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
