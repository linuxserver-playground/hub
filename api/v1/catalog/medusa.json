 to python3."},{"date":"2019-06-28","desc":"Rebasing to alpine 3.10."},{"date":"2019-03-23","desc":"Switching to new Base images, shift to arm32v7 tag."},{"date":"2019-02-22","desc":"Rebasing to alpine 3.9."},{"date":"2019-01-14","desc":"Adding multi arch and pipeline logic"},{"date":"2018-08-16","desc":"Rebase to alpine 3.8"},{"date":"2017-12-08","desc":"Rebase to alpine 3.7"},{"date":"2017-11-29","desc":"Add py-gdbm for subtitles support"},{"date":"2017-10-26","desc":"Mediainfo moved from testing to community repo"},{"date":"2017-10-10","desc":"Use repo version of mediainfo to shorten build time"},{"date":"2017-08-05","desc":"Internal git pull instead of at runtime"},{"date":"2017-05-25","desc":"Rebase to alpine 3.6"},{"date":"2017-02-07","desc":"Rebase to alpine 3.5"},{"date":"2017-01-02","desc":"Initial Release"}],"config":{"application_setup":"https://github.com/linuxserver-playground/docker-medusa?tab=readme-ov-file#application-setup","readonly_supported":false,"nonroot_supported":false,"env_vars":[{"name":"PUID","value":"1000","desc":"User ID","optional":false},{"name":"PGID","value":"1000","desc":"Group ID","optional":false},{"name":"TZ","value":"Etc/UTC","desc":"Timezone","optional":false}],"volumes":[{"path":"/config","host_path":"/path/to/medusa/config","desc":"Persistent config files","optional":false},{"path":"/downloads","host_path":"/path/to/downloads","desc":"Download location","optional":false},{"path":"/tv","host_path":"/path/to/tv/shows","desc":"TV Shows location","optional":false}],"ports":[{"external":"8081","internal":"8081","desc":"The port for the Medusa webui","optional":false}]},"title":"Medusa","sponsor":[],"maintainers":[],"kind":"app","categories":["Media Management"],"setup_instructions":"Web interface is at `<your ip>:8081`.\n\nSet paths for downloads, tv-shows to match docker mappings via the webui, for more information check out [Medusa](https://pymedusa.com/).","archived":false,"release_url":"https://github.com/linuxserver-playgroun