ity (46c5442 by Henry Heino)\r\n- Security: Harden server share API response handling (64d513a by Henry Heino)\r\n- Security: Prevent OneNote import from reading files outside the import directory (86250d4)\r\n- Security: Sync/E2EE: Do not mark items as published based on the list of shares returned by the server (2d1a179 by Henry Heino)\r\n- Security: Sync/E2EE: Harden marking items as published/shared (3cf1c1a by Henry Heino)\r\n- Security: Sync: Do not allow a remote item to decrypt/deserialize to an item with a different ID (b61ef1e by Henry Heino)","upstream_url":"https://github.com/laurent22/joplin/releases/tag/v3.7.24"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Joplin","LSIO_FIRST_PARTY=true","NO_GAMEPAD=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/joplin/builds/v3.7.24-ls13.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/joplin/builds/v3.7.24-ls13/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/joplin/builds/v3.7.24-ls13/layers.amd64.json"},"packages":{},"release":"https://github.c