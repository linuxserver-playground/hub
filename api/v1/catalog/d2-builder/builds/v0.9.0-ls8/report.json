 installing, instead of incorrectly claiming that older D2 releases bundle TALA\n- sequence diagrams: keep synthetic lifeline endpoint IDs stable across architectures\n- exports: honor `D2_TIMEOUT` during PNG and GIF rendering\n- compiler: keep recursive globs out of class and variable definitions and report class reference cycles instead of overflowing the stack\n- renders: decode gzip, Brotli, and deflate remote images before embedding them\n\n---\n\nFor the latest d2.js changes, see separate [changelog](https://github.com/d2lang/d2/blob/master/d2js/js/CHANGELOG.md).\n","upstream_url":"https://github.com/d2lang/d2/releases/tag/v0.9.0"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=2","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","S6_BEHAVIOUR_IF_STAGE2_FAILS=2"],"entrypoint":["/init-d2"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/d2-builder/builds/v0.9.0-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/d2-builder/builds/v0.9.0-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/d2-builder/builds/v0.9.0-ls8/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/d2-builder/builds/v0.9.0-ls8/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-d2-builder/releases/tag/v0.9.0-ls8","pages":"https://linuxserver-playground.github.io/docker-d2-builder/builds/v0.9.0-ls8/","files":{"amd64":"https://linuxserver-playground.github.io/docker-d2-builder/builds/v0.9.0-ls8/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-d2-builder/builds/v0.9.0-ls8/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-d2-builder/b