# scummvm.container: generated by the hub from https://github.com/linuxserver-playground/docker-scummvm/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Scummvm (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/scummvm:latest
ContainerName=scummvm
AutoUpdate=registry
# PodmanArgs=--security-opt seccomp=unconfined
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/config:/config:Z
PublishPort=3000:3000
PublishPort=3001:3001

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
