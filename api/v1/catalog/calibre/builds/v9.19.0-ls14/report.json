Changelog**: https://github.com/linuxserver-playground/docker-calibre/compare/v9.19.0-ls13...v9.19.0-ls14","upstream":"<div><h2>New Features</h2><ul>\n<li>Edit book: Add grammar checking and suggestions for rewriting sentences</li>\n<li>PDF Input: Greatly improve detection of paragraphs, headings and columns</li>\n<li>Content server: Allow downloading metadata and covers in the book metadata editor</li>\n<li>Content server and E-book viewer: Many more accessibility improvements for keyboard and screen reader users, including dialogs, the footnote popup, the Read aloud and audio ebook controls, the color scheme and selection bar settings and rating books at their end</li>\n<li>Content server: Allow non-ASCII passwords</li>\n<li>Get books: Use a browser to search the Amazon stores, so that stores other than Amazon US return results</li>\n<li>Conversion: Speed up building large Tables of Contents and splitting large HTML files for EPUB output</li>\n<li>Edit book: Check book: Speed up fixing many link and id errors</li>\n<li>Auto-add: Improve detection of files that are still being downloaded</li>\n</ul>\n<h2>Bug Fixes</h2><ul>\n<li>Fix a regression in 9.16 that broke restoring the sort of the book list when it included fields that cannot be sorted on</li>\n<li>RTF Output: Fix nested lists and other nested block elements being run together into a single paragraph</li>\n<li>RTF Input: Fix conversion of files using East Asian, Thai and Vietnamese code pages</li>\n<li>ebook-meta/ebook-convert: Fix the --rating option being interpreted as out of ten instead of a number of stars</li>\n<li>Edit metadata dialog: Fix setting metadata from a format doubling the rating</li>\n<li>Edit book: Check book: Fix case mismatches in the OPF manifest causing the auto-fix to delete the file</li>\n<li>Polish book: Fix updating the cover adding a new cover page each time</li>\n<li>Fix extracting the cover from calibre generated SVG cover pages</li>\n<li>Fix setting the title of EPUB 3 books whose first title is a subtitle</li>\n<li>Conversion: Generate valid ids for non-ASCII Markdown headings</li>\n<li>PDF Input: Fix Table of Contents entries that link via JavaScript actions</li>\n<li>Heuristics: Preserve page anchors when dehyphenating across pages</li>\n<li>Fix reading damaged ZIP files whose data descriptors lack a signature</li>\n<li>PDF metadata: Fix escaped strings being carried over from corrupted XMP metadata</li>\n<li>Decode numeric HTML entities as specified by HTML5</li>\n<li>Kobo driver: Handle boolean columns stored as either text or integers</li>\n<li>MTP driver: Show a clearer error message on Windows when the device stops responding</li>\n<li>Fix icons in the system tray menu showing as missing on some Linux desktops</li>\n<li>E-book viewer/Edit book: Fix the close button in the Inspector toolbar not working</li>\n<li>Content server: Fix changed covers not being shown until the page is reloaded</li>\n<li>Content server: Fix an error when pressing OK while editing a rating or enumeration whose value is not one of the choices</li>\n<li>Metadata download: Fix camoufox being downloaded over and over when installing it fails</li>\n</ul></div>","upstream_url":"https://calibre-ebook.com/download"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Calibre","LSIO_FIRST_PARTY=true","CUSTOM_PORT=8080","CUSTOM_HTTPS_PORT=8181","QTWEBENGINE_DISABLE_SANDBOX=1","NO_GAMEPAD=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14/layers.arm64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14/packages.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/calibre/builds/v9.19.0-ls14/packages.arm64.json"},"release":"https://github.com/linuxserver-playground/docker-calibre/releases/tag/v9.19.0-ls14","pages":"https://linuxserver-playground.github.io/docker-calibre/builds/v9.19.0-ls14/","files":{"amd64":"https://linuxserver-playground.github.io/docker-calibre/builds/v9.19.0-ls14/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-calibre/builds/v9.19.0-ls14/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-calibre/builds/v9.19.0-ls14/packages.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-calibre/builds/v9.19.0-ls14/packages.arm64.json.gz"},"run_json":"https://github.com/linuxserver-playground/docker-calibre/releases/download/v9.19.0-ls14/run.json","logs_zip":"https://github.com/linuxserver-playground/docker-calibre/releases/download/v9.19.0-ls14/logs.zip","test_report":"https://linuxserver-playground.github.io/site/images/calibre/builds/v9.19.0-ls14/","tests":"https://linuxserver-playground.git