 changed","1 commit (3e6ac7c → d6b51cf): the pipeline's own package table update"],"upstream":{"from":"1:2126.2-1","to":"1:2126.2-1","changed":false},"base_changed":true,"base_from":"sha256:52fa07df164b16b16aef191b51e80acf9911a6dd98d836f3e41cee05b1c07f37","size":{"amd64":{"from":1861661376,"to":1862297797,"delta":636421}},"totals":{"added":3,"removed":0,"upgraded":34,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":1571,"distro":"Arch Linux","hash":"b6a3359e","by_type":{"UnknownPackage":381,"unknown":73,"python":102,"binary":6,"alpm":550,"go-module":431,"rpm":25,"java-archive":3}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-azahar/compare/12126.2-1-ls7...12126.2-1-ls8","upstream":"This a minor release for the 2126 branch which primarily addresses a reported security advisory.\r\nIt also includes several newly backported improvements and fixes from the master branch.\r\n\r\nUsers are advised to update as soon as is convenient.\r\n\r\n---\r\n\r\n# Azahar 2126.2 Changelog\r\n\r\n# All\r\n\r\n- Addressed an oversight which allowed specially-crafted CIA files to execute arbitrary code in the host environment when locally installed by a user. | @PabloMK7 #2648 \r\n  - Addresses the following GHSA report: https://github.com/azahar-emu/azahar/security/advisories/GHSA-h74v-5mw8-qg8r\r\n- Fixed an issue where the xBRZ texture filter would be applied incorrectly when using the Vulkan renderer, resulting in an incorrect appearance. | @OpenSauce04 #2647 \r\n- Handling of large HTTP downloads within emulated 3DS applications has been improved, improving memory efficiency and stability. | @PabloMK7 #2515 \r\n   - Fixes downloading large games from the eShop. \r\n- Added a new 3GX loader flag `allow_homebrew_load`, which allows loading 3GX plugins for homebrew apps if the plugin supports it. | @PabloMK7 #2649\r\n\r\n# Desktop\r\n\r\n- Various improvements to GDB and RPC servers, fixing certain issues and improving functionality. | @PabloMK7 #2631, #2640, #2633\r\n  - For additional info, see individual PR descriptions.\r\n  - Script developers will need to update the RPC client as this is a breaking change. \r\n\r\n# Android\r\n\r\n- Fixed a crash which could occur if the `gpu_drivers` directory contained a subdirectory. | @ygordreyer #2592\r\n\r\n# Technical\r\n\r\n- Creating a copy of the kernel shared and config pages using svcMapProcessMemoryEx is now possible.\r\n  - This is a technical accuracy change. Little to no end-user impact.","upstream_url":"https://github.com/azahar-emu/azahar/releases/tag/2126.2"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/config","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","LC_ALL=en_US.UTF-8","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Azahar","LSIO_FIRST_PARTY=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/azahar/builds/12126.2-1-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/azahar/builds/12126.2-1-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/azahar/builds/12126.2-1-ls8/layers.amd64.json"},"packages":{},"release":"https://github.c