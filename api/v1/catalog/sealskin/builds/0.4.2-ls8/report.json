SealSkin 0.4.2\n\nMaintenance release.\n\n## Changes\n\n* **PRoot Apps catalogs from a private remote.** When\n  `SEALSKIN_PROOT_APPS_REMOTE` names a private proot-apps repository, its\n  apps keep their short names in a catalog. A session on a catalog now gets\n  `PA_DEFAULT_REPO`, the registry of that remote, so `proot-apps install\n  <app>` and the app's desktop entries resolve to the private registry\n  rather than `ghcr.io/linuxserver/proot-apps`. Apps of any other remote are\n  still installed by their full image name.\n* Dependency updates for the server and the client.\n","upstream_url":"https://github.com/selkies-project/sealskin/releases/tag/0.4.2"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/config","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true"],"exposed_ports":["8000/tcp","8443/tcp"],"volumes":["/config","/storage"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sealskin/builds/0.4.2-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sealskin/builds/0.4.2-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sealskin/builds/0.4.2-ls8/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sealskin/builds/0.4.2-ls8/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-sealskin/releases/tag/0.4.2-ls8","pages":"https://linuxserver-playground.github.io/docker-sealskin/builds/0.4.2-ls8/","files":{"amd64":"https://linuxserver-playground.github.io/docker-sealskin/builds/0.4.2-ls8/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-sealskin/builds/0.4.2-ls8/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-pla