und.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/amd64/screenshot.png","sysinfo":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/amd64/sysinfo.txt"}},"arm64":{"success":true,"passed":12,"failed":0,"total":12,"failed_tests":[],"startup_seconds":2.01,"listening_ports":["8337/tcp"],"warnings":0,"rss_bytes":76664832,"pids":13,"tarball":"https://github.com/linuxserver-playground/docker-beets/releases/download/nightly-3b34ac8c-ls26/test.arm64.tar.gz","files":{"browser_log":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/arm64/browser.log","container_log":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/arm64/container.log","screenshot":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/arm64/screenshot.png","sysinfo":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/arm64/sysinfo.txt"}}},"classification":"mixed","diff":{"previous_tag":"nightly-ab4bdfd5-ls2","classification":"mixed","reasons":["upstream version changed","base image digest changed","packages changed","20 commits (4a29621 → accf670): the pipeline's own generated files"],"upstream":{"from":"ab4bdfd5","to":"3b34ac8c","changed":true},"base_changed":true,"base_from":"sha256:2407abb0b4203bf43b927c1004200b3a54815aa39e7544ec48079df3f0154cc5","size":{"amd64":{"from":237475567,"to":236431148,"delta":-1044419},"arm64":{"from":228737893,"to":228577513,"delta":-160380}},"totals":{"added":0,"removed":0,"upgraded":96,"downgraded":2},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":470,"distro":"Alpine Linux v3.23","hash":"0fb58377","by_type":{"python":100,"UnknownPackage":14,"binary":14,"apk":245,"rust-crate":97}},"arm64":{"count":469,"distro":"Alpine Linux v3.23","hash":"2f9b57b5","by_type":{"python":100,"UnknownPackage":14,"binary":14,"apk":244,"rust-crate":97}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-beets/compare/nightly-458390ea-ls25...nightly-3b34ac8c-ls26","upstream":"Fix empty db migration backup (#7171)\n\n## Description\n\nFixes #7170.\n\nWhen beets creates a new library, it runs every migration on the fresh\ndatabase,\nand each one made a backup first. A brand-new, empty library ended up\nwith 11\n`.bak` files and 11 \"Created database backup\" lines, even for `beet\nversion`.\n\nThis PR makes `_before_migration_backup` in `beets/dbcore/db.py` skip\nthe\nbackup when the table being migrated has no rows (`SELECT 1 FROM <table>\nLIMIT 1`).\nAn empty table has no data for a migration to change, so there's nothing\nto\nprotect. The migrations still run and are still recorded, so they won't\nbe\nretried on the next start.\n\nTables that contain data are backed up exactly as before.\n\n**Before:** fresh `BEETSDIR` + `beet version` → 11 `.bak` files.\n**After:** fresh `BEETSDIR` + `beet version` → 0 `.bak` files, 11\nmigrations recorded.\n\n## To Do\n\n- [x] ~Documentation.~ (bug fix, no user-facing option changes)\n- [x] Changelog.\n- [x] Tests. Added `test_no_backup_for_empty_table` to\n`TestMigrationBackup`. It\nfails without the fix and passes with it; the existing\n`test_backup_config`\n  (which expects one backup when the table has data) still passes.\n\n`poe lint`, `poe check-format` and `poe lint-docs` pass. The full test\nsuite\npasses locally except `test_importfeeds.py::test_link_creates_symlink`,\nwhich\nalso fails on unmodified `master` on Windows (symlinks need admin or\nDeveloper\nMode) and is unrelated.\n\n---\n\n*AI disclosure: An AI assistant (Claude) helped me find and reproduce\nthis bug,\nexplained the code, suggested the approach, and drafted this\ndescription. I\nwrote the code change and the test myself and can answer questions about\nthem.*","upstream_url":"https://github.com/beetbox/beets/commit/3b34ac8cb8d3054e189e91df011eee808c97d0b7"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/config","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","BEETSDIR=/config","EDITOR=nano"],"exposed_ports":["8337/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/beets/builds/nightly-3b34ac8c-ls26.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/beets/builds/nightly-3b34ac8c-ls26/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/beets/builds/nightly-3b34ac8c-ls26/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/beets/builds/nightly-3b34ac8c-ls26/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-beets/releases/tag/nightly-3b34ac8c-ls26","pages":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/","files":{"amd64":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/packages.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-beets/builds/nightly-3b34ac8c-ls26/packages.arm64.json.gz"},"run_json":"https://github.com/linuxserver-playground/docker-beets/releases/download/nightly-3b34ac8c-ls26/run.json","logs_zip":"https://github.com/linuxserver-playground/docker-beets/releases/download/nightly-3b34ac8c-ls26/logs.zip","test_report":"https://linuxserver-playground.github.io/site/images/beets/builds/nightly-3b34ac8c-ls26/","tests":"https://linuxserver-playground.github.io/hub/api/v1/catalog/beets/builds/nightly-3b34ac8c-ls26/tes