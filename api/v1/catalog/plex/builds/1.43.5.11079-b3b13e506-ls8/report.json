:{"from":170851884,"to":170598799,"delta":-253085}},"totals":{"added":0,"removed":0,"upgraded":8,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":162,"distro":"Ubuntu 26.04.1 LTS","hash":"e6718d5e","by_type":{"deb":151,"go-module":11}},"arm64":{"count":162,"distro":"Ubuntu 26.04.1 LTS","hash":"56eb0c4a","by_type":{"deb":151,"go-module":11}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-plex/compare/1.43.5.11079-b3b13e506-ls7...1.43.5.11079-b3b13e506-ls8","upstream":"### Added\n(Metadata) Added support for reading artist and album metadata from NFO files in music libraries (PM-6153)\n(Network) Ignore manually specified public port for IPv6 connections (PM-5364)\n(Network) Send subnet information to plex.tv so IPv6 and non-private local connections are detected correctly (PM-5364)\n(Security) The server no longer trusts the eMudhra certificate authority roots whose intermediate signing keys were compromised (PM-6479)\nUpdated Web to 4.162.1\n\n### Fixed\n(Butler) Scheduled loudness analysis ran on movie and TV libraries that had it disabled (PM-6263)\n(DVR) Harden validation of the post-processing script setting (PM-5538)\n(Metadata) Stream display titles left out the format for Plex for Roku (PM-5906)\n(Music) The record label was not read from the ID3v2 publisher (TPUB) tag in MP3 files (PM-3800)\n(Network) Added IPv6 support to the preferred network interface (PM-6017)\n(Network) Try every resolved address when connecting to pubsub servers (PM-5760)\n(Remote Access) The server could keep reporting its port as mapped after remote access was disabled, which left Plex Web waiting indefinitely (PM-6260)\n(Security) Address a library scoping issue in search results (PM-5958)\n(Security) Fixed request locality when the server's local network interface is unknown (PM-6183)\n(Security) Increase security on requests arriving through a proxy (PM-6201)\n(Thumbnails) Video preview thumbnail generation on Windows no longer leaves temporary index files behind; bundle cleanup removes existing ones (PM-3536)\n(Transcoder) Photos could fail to load for clients connecting through a reverse proxy (PM-6476)\n(Transcoder) The server could crash while building an HLS playlist for media without a video stream (PM-6226)\n(UltraBlur) Colors were computed from the thumbnail when an item had no artwork of its own, so episodes and seasons did not match the background shown by clients (PM-4282)","upstream_url":"https://plex.tv/api/downloads/5.json"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/root","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics","DEBIAN_FRONTEND=noninteractive","PLEX_DOWNLOAD=https://downloads.plex.tv/plex-media-server-new","PLEX_ARCH=amd64","PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR=/config/Library/Application Support","PLEX_MEDIA_SERVER_HOME=/usr/lib/plexmediaserver","PLEX_MEDIA_SERVER_MAX_PLUGIN_PROCS=6","PLEX_MEDIA_SERVER_USER=abc","PLEX_MEDIA_SERVER_INFO_VENDOR=Docker","PLEX_MEDIA_SERVER_INFO_DEVICE=Docker Container (LinuxServer.io)","TMPDIR=/run/plex-temp","ATTACHED_DEVICES_PERMS=/dev/dri /dev/dvb -type c"],"exposed_ports":["1900/udp","32400/tcp","32410/udp","32412/udp","32413/udp","32414/udp","32469/tcp","5353/udp","8324/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/plex/builds/1.43.5.11079-b3b13e506-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/plex/builds/1.43.5.11079-b3b13e506-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/plex/builds/1.43.5.11079-b3b13e506-ls8/layers.amd64.json","arm64":"https