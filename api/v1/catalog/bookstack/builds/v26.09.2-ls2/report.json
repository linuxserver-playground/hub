ed"],"upstream":{"from":"v26.09.2","to":"v26.09.2","changed":false},"base_changed":false,"size":{"amd64":{"from":133084984,"to":133083884,"delta":-1100},"arm64":{"from":133544818,"to":133545860,"delta":1042}},"totals":{"added":0,"removed":0,"upgraded":0,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":304,"distro":"Alpine Linux v3.24","hash":"32a2d7a3","by_type":{"binary":11,"apk":141,"php-composer":152}},"arm64":{"count":304,"distro":"Alpine Linux v3.24","hash":"32a2d7a3","by_type":{"binary":11,"apk":141,"php-composer":152}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-bookstack/compare/v26.09.2-ls1...v26.09.2-ls2","upstream":"### Security Release\r\n\r\n* [Update Instructions](https://www.bookstackapp.com/docs/admin/updates)\r\n* [Update details on blog](https://www.bookstackapp.com/blog/bookstack-release-v26-09-2/)\r\n\r\nThis is a security release to address the following vulnerabilities:\r\n\r\n- Comments of deleted pages could remain visible to API users while the page remained in the recycle bin.\r\n- Attachments of pages could be modified by others (that have attachment update/delete permissions), while that page remained in draft status. \r\n\r\nThis update also includes various security improvements, which can be found listed below.\r\n\r\nUpdating is generally advised, but more so if either of the above two scenarios is a concern for your instance.\r\n\r\nA big thanks to the following researchers for responsibly reporting vulnerabilities and security considerations, which were addressed in this release:\r\n\r\n- Huzaifa Dal ([GitHub](https://github.com/HuzaifaDal), [LinkedIn](https://www.linkedin.com/in/muhammad-huzaifa-dal-574a1529b/))\r\n- Nicol (cqliuke)\r\n- Semilore Osofisan (of Seneca Polytechnic, reporting as part of their WAS705 application security project)\r\n- VG\r\n- Xora ([Website](https://getxora.ai))\r\n\r\n### Full List of Changes\r\n\r\n- Updated user password change to also drop any remember-me cookies to limit existing session use.\r\n- Updated ZIP import validation to check total uncompressed sizes to help limit denial of service attacks.\r\n- Updated SAML2 routes to prevent nuisance cross-site requests causing logouts.\r\n- Updated PHP package versions.\r\n- Fixed comments incorrectly showing in the API when their related pages are in the recycle bin.\r\n- Fixed the permissions checked for attachment actions to consider draft status of the related page.","upstream_url":"https://codeberg.org/bookstack/bookstack/releases/tag/v26.09.2"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/init-hook","VIRTUAL_ENV=/lsiopy","PHP_INI_SCAN_DIR=:/config/php","LSIO_FIRST_PARTY=true"],"exposed_ports":["443/tcp","80/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-bookstack/releases/tag/v26.09.2-ls2","pages":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.2-ls2/","files":{"amd64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.2-ls2/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.2-ls2/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.2-ls2/packages.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.2-ls2/packages.arm64.json.gz"},"run_json":"https://github.com/linuxserver-playground/docker-bookstack/releases/download/v26.09.2-ls2/run.json","logs_zip":"https://github.com/linuxserver-playground/docker-bookstack/releases/download/v26.09.2-ls2/logs.zip","test_report":"https://linuxserver-playground.github.io/site/images/bookstack/builds/v26.09.2-ls2/","tests":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2/tests.json","report":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.2-ls2/report.json","run":"https://github.com/linuxserver-playground/docker-bookstack/actions/runs/40213589520","commit":"https://github.com/linuxserver-playground/docker-bookstack/commit/3a00b4b2f71613d29433ab10bb732cb1965b01ed","repository":"https://github.com/linuxserver-playground/docker-bookstack","registry":"ghcr.io/linuxserver-playground/bookstack:v26.09.2-ls2","history":"https://linuxserver-playground.github.io/site/images/bookstack/#builds"}}}}