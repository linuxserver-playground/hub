igest changed","packages changed","1 commit (6aad927 → d239487): the pipeline's own package table update"],"upstream":{"from":"v26.09.3","to":"v26.09.3","changed":false},"base_changed":true,"base_from":"sha256:3130ae80cea2fa20c89e2c0cc679da86bbb257b3fc9f51a1d9ab6393e5cb7f81","size":{"amd64":{"from":134199874,"to":134203721,"delta":3847},"arm64":{"from":134625456,"to":134624166,"delta":-1290}},"totals":{"added":0,"removed":0,"upgraded":6,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":306,"distro":"Alpine Linux v3.24","hash":"9c0ac439","by_type":{"binary":13,"apk":141,"php-composer":152}},"arm64":{"count":306,"distro":"Alpine Linux v3.24","hash":"9c0ac439","by_type":{"binary":13,"apk":141,"php-composer":152}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-bookstack/compare/v26.09.3-ls7...v26.09.3-ls8","upstream":"### Security Release\r\n\r\n* [Update Instructions](https://www.bookstackapp.com/docs/admin/updates)\r\n* [Update details on blog](https://www.bookstackapp.com/blog/bookstack-release-v26-09-3/)\r\n\r\nThis is a security release to address a range of vulnerabilities:\r\n\r\n- Images & drawings could be unexpectedly accessed and modified when attached to inaccessible draft/trashed pages.\r\n- Page editor personal draft content could be made visible to other users in certain scenarios.\r\n- On book/chapter conversion, content could be wrongly permanently deleted when in the recycle bin.\r\n- Attachment endpoints could indicate existence of non-accessible pages.\r\n\r\nUpdating is advised if any of the above scenarios are a concern to your use-case.\r\n\r\nA big thanks to the following researchers for responsibly reporting vulnerabilities which were addressed in this release:\r\n\r\n- CayCon (Reporter), [VulnCheck](https://www.vulncheck.com/) (Coordinator)\r\n- Tanna Zu ([GitHub](https://github.com/226xiang))\r\n- Dickson Wu (SEAL & CertiK)\r\n- Zeng Yu\r\n- Efe Çam\r\n- dracaryxxd\r\n\r\n### Full List of Changes\r\n\r\n* Updated application PHP package versions\r\n* Updated attachment validation, and page fetching, to avoid responses which indicate page existence.\r\n* Updated image fetching to fully check access via page access, considering draft and trashed status.\r\n* Updated revision diffing to filter on revision type.\r\n* Updated chapter/book conversion to properly handle child items which are in the recycle bin.","upstream_url":"https://codeberg.org/bookstack/bookstack/releases/tag/v26.09.3"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/init-hook","VIRTUAL_ENV=/lsiopy","PHP_INI_SCAN_DIR=:/config/php","LSIO_FIRST_PARTY=true"],"exposed_ports":["443/tcp","80/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8/layers.arm64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8/packages.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls8/packages.arm64.json"},"release":"https://github.com/linuxserver-playground/docker-bookstack/releases/tag/v26.09.3-ls8","pages":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls8/","files":{"amd64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls8/files.amd64.json.