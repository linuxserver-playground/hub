ersion changed","base image digest changed","packages changed","5 commits (4488564 → 6aad927): the pipeline's own generated files"],"upstream":{"from":"v26.09.2","to":"v26.09.3","changed":true},"base_changed":true,"base_from":"sha256:b0d56c4c1b2d8029704eca17211f594e60c1372e06ce26e921fccae8479c3a14","size":{"amd64":{"from":133083984,"to":134199874,"delta":1115890},"arm64":{"from":133546864,"to":134625456,"delta":1078592}},"totals":{"added":0,"removed":0,"upgraded":106,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":306,"distro":"Alpine Linux v3.24","hash":"e76d18d1","by_type":{"binary":13,"apk":141,"php-composer":152}},"arm64":{"count":306,"distro":"Alpine Linux v3.24","hash":"e76d18d1","by_type":{"binary":13,"apk":141,"php-composer":152}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-bookstack/compare/v26.09.2-ls6...v26.09.3-ls7","upstream":"### Security Release\r\n\r\n* [Update Instructions](https://www.bookstackapp.com/docs/admin/updates)\r\n* [Update details on blog](https://www.bookstackapp.com/blog/bookstack-release-v26-09-3/)\r\n\r\nThis is a security release to address a range of vulnerabilities:\r\n\r\n- Images & drawings could be unexpectedly accessed and modified when attached to inaccessible draft/trashed pages.\r\n- Page editor personal draft content could be made visible to other users in certain scenarios.\r\n- On book/chapter conversion, content could be wrongly permanently deleted when in the recycle bin.\r\n- Attachment endpoints could indicate existence of non-accessible pages.\r\n\r\nUpdating is advised if any of the above scenarios are a concern to your use-case.\r\n\r\nA big thanks to the following researchers for responsibly reporting vulnerabilities which were addressed in this release:\r\n\r\n- CayCon (Reporter), [VulnCheck](https://www.vulncheck.com/) (Coordinator)\r\n- Tanna Zu ([GitHub](https://github.com/226xiang))\r\n- Dickson Wu (SEAL & CertiK)\r\n- Zeng Yu\r\n- Efe Çam\r\n- dracaryxxd\r\n\r\n### Full List of Changes\r\n\r\n* Updated application PHP package versions\r\n* Updated attachment validation, and page fetching, to avoid responses which indicate page existence.\r\n* Updated image fetching to fully check access via page access, considering draft and trashed status.\r\n* Updated revision diffing to filter on revision type.\r\n* Updated chapter/book conversion to properly handle child items which are in the recycle bin.","upstream_url":"https://codeberg.org/bookstack/bookstack/releases/tag/v26.09.3"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/init-hook","VIRTUAL_ENV=/lsiopy","PHP_INI_SCAN_DIR=:/config/php","LSIO_FIRST_PARTY=true"],"exposed_ports":["443/tcp","80/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls7.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls7/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls7/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/bookstack/builds/v26.09.3-ls7/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-bookstack/releases/tag/v26.09.3-ls7","pages":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls7/","files":{"amd64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls7/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls7/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-bookstack/builds/v26.09.3-ls7