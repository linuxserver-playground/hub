desk","sponsor":[{"name":"RustDesk (GitHub Sponsors)","url":"https://github.com/sponsors/rustdesk"},{"name":"RustDesk (Ko-fi)","url":"https://ko-fi.com/rustdesk"}],"maintainers":[],"kind":"app","categories":["Remote Desktop"],"setup_instructions":"The application can be accessed at:\n\n* https://yourhost:3001/\n\n**Note: This is the Desktop application in a web accessible format! This container is for running the client in a sandbox so it does not have access to your system. It is not a server solution!**","archived":false,"release_url":"https://github.com/linuxserver-playground/docker-rustdesk/releases/tag/1.5.3-ls8","upstream_version":"1.5.3","base":"selkies","releases":[{"branch":"master","release_tag":"latest","channel":"stable","tag":"1.5.3-ls8","upstream_version":"1.5.3","created":"2026-11-11T09:13:11Z","release_url":"https://github.com/linuxserver-playground/docker-rustdesk/releases/tag/1.5.3-ls8","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-selkies:debiantrixie","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/rustdesk/","registries":{"ghcr":"ghcr.io/linuxserver-playground/rustdesk","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/rustdesk"},"snippets":{"docker_compose":"---\nservices:\n  rustdesk:\n    image: ghcr.io/linuxserver-playground/rustdesk:latest\n    container_name: rustdesk\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n    volumes:\n      - /path/to/config:/config\n    ports:\n      - 3000:3000\n      - 3001:3001\n    shm_size: \"1gb\"\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=rustdesk \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -p 3000:3000 \\\n  -p 3001:3001 \\\n  -v /path/to/config:/config \\\n  --shm-size=\"1gb\" \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/rustdesk:latest\n"},"links":{"builds":"https://linuxserver-playground.gi