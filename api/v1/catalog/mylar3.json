1.0-ls6","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-ubuntu:jammy","platforms":["amd64","arm64"]},{"branch":"nightly","release_tag":"nightly","channel":"prerelease","tag":"nightly-3cab379d-ls6","upstream_version":"3cab379d","created":"2026-11-04T13:17:20Z","release_url":"https://github.com/linuxserver-playground/docker-mylar3/releases/tag/nightly-3cab379d-ls6","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.24","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/mylar3/","registries":{"ghcr":"ghcr.io/linuxserver-playground/mylar3","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/mylar3"},"snippets":{"docker_compose":"---\nservices:\n  mylar3:\n    image: ghcr.io/linuxserver-playground/mylar3:latest\n    container_name: mylar3\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n    volumes:\n      - /path/to/mylar3/config:/config\n      - /path/to/comics:/comics\n      - /path/to/downloads:/downloads\n    ports:\n      - 8090:8090\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=mylar3 \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -p 8090:8090 \\\n  -v /path/to/mylar3/config:/config \\\n  -v /path/to/comics:/comics \\\n  -v /path/to/downloads:/downloads \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/mylar3:latest\n"},"links":{"builds":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mylar3/builds.json","docs":"https://linuxserver-playground.github.io/hub/stores/docs/images/docker-mylar3.md","documentation":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mylar3/docs.json","proxy":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mylar3/proxy.json","kubernetes":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mylar3/kubernetes.yaml","quadlet":"https://linuxserver-playground.github.io/hub/api/v1/ca