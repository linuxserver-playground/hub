r-playground/docker-sabnzbd/compare/nightly-6345928d-ls26...nightly-49e7ed40-ls27","upstream":"Report peer for incoming connections when SOCKS5 proxy is active\n\nWhen `socket.socket` is replaced by `socks.socksocket` for SOCKS5 proxying, accepted incoming connections would incorrectly report `None` for their peer address. This prevents web server access checks and other functionality from identifying the client.\n\nThe new `ProxiedSocket` class overrides `getpeername()` to ensure that incoming connections correctly retrieve the actual peer address, allowing the web server to function as expected while the SOCKS5 proxy is enabled.\n\nCloses #3594. Based on #3595.","upstream_url":"https://github.com/sabnzbd/sabnzbd/commit/49e7ed40867047c9550cd888c7ea1048536129dd"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/config","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","PYTHONIOENCODING=utf-8"],"exposed_ports":["8080/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sabnzbd/builds/nightly-49e7ed40-ls27.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sabnzbd/builds/nightly-49e7ed40-ls27/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sabnzbd/builds/nightly-49e7ed40-ls27/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/sabnzbd/builds/nightly-49e7ed40-ls27/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-sabnzbd/releases/tag/nightly-49e7ed40-ls27","pages":"https://linuxserver-playground.github.io/docker-sabnzbd/builds/nightly-49e7ed40-ls27/","files":{"amd64":"https://linuxserver-playground.github.io/docker-sabnzbd/builds/ni