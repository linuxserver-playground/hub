{"status":"OK","last_updated":"2026-11-14 11:23:23+00:00","data":{"image":{"name":"thelounge","initial_date":"2016-08-31","github_url":"https://github.com/linuxserver-playground/docker-thelounge","project_url":"https://thelounge.github.io/","project_logo":"https://raw.githubusercontent.com/thelounge/thelounge/master/client/img/logo-vertical-transparent-bg.svg?sanitize=true","description":"[Thelounge](https://thelounge.github.io/) (a fork of shoutIRC) is a web IRC client that you host on your own server.","version":"v4.5.2-ls6","version_timestamp":"2026-11-12 18:33:29+00:00","category":"IRC,Chat","stable":true,"deprecated":false,"stars":0,"tags":[{"tag":"latest","desc":"Stable releases."},{"tag":"next","desc":"Next Pre-Releases."},{"tag":"nightly","desc":"Nightly images from commits in master."}],"architectures":[{"arch":"x86_64","tag":"amd64-latest"},{"arch":"arm64","tag":"arm64v8-latest"}],"changelog":[{"date":"2025-07-27","desc":"Rebase to Alpine 3.22."},{"date":"2024-06-06","desc":"Rebase to Alpine 3.20."},{"date":"2023-12-23","desc":"Rebase to Alpine 3.19."},{"date":"2023-05-25","desc":"Rebase to Alpine 3.18, deprecate armhf."},{"date":"2022-12-18","desc":"Rebasing master to alpine 3.17."},{"date":"2022-10-24","desc":"Fix sqlite3 build."},{"date":"2022-04-12","desc":"Install from source using yarn."},{"date":"2022-04-11","desc":"Rebasing to alpine 3.15 and switching from python2-dev to python3-dev for building node sqlite on arm."},{"date":"2021-01-23","desc":"Rebasing to alpine 3.13."},{"date":"2020-06-02","desc":"Rebasing to alpine 3.12."},{"date":"2019-12-19","desc":"Rebasing to alpine 3.11."},{"date":"2019-06-28","desc":"Rebasing to alpine 3.10."},{"date":"2019-05-15","desc":"Update Arm variant images to build sqlite3 module."},{"date":"2019-03-23","desc":"Switching to new Base images, shift to arm32v7 tag."},{"date":"2019-02-22","desc":"Rebasing to alpine 3.9."},{"date":"2019-01-28","desc":"Add pipeline logic and multi arch."},{"date":"2018-08-25","desc":"Use global install, simplifies adding users."},{"date":"2018-08-20","desc":"Rebase to alpine 3.8."},{"date":"2018-01-06","desc":"Rebase to alpine 3.7."},{"date":"2017-05-26","desc":"Rebase to alpine 3.6."},{"date":"2017-02-06","desc":"Rebase to alpine 3.5."},{"date":"2016-10-14","desc":"Bump to pickup 2.10 release."},{"date":"2016-10-14","desc":"Add version layer information."},{"date":"2016-09-11","desc":"Add layer badges to README."},{"date":"2016-08-31","desc":"Initial Release."}],"config":{"application_setup":"https://github.com/linuxserver-playground/docker-thelounge?tab=readme-ov-file#application-setup","readonly_supported":true,"env_vars":[{"name":"PUID","value":"1000","desc":"User ID","optional":false},{"name":"PGID","value":"1000","desc":"Group ID","optional":false},{"name":"TZ","value":"Etc/UTC","desc":"Timezone","optional":false}],"volumes":[{"path":"/config","host_path":"/path/to/thelounge/config","desc":"Persistent config files","optional":false}],"ports":[{"external":"9000","internal":"9000","desc":"Application WebUI","optional":false}]},"title":"Thelounge","sponsor":[],"maintainers":[],"kind":"app","categories":["IRC","Chat"],"setup_instructions":"* When the application first runs, it will populate its /config\n\n* Stop the container\n\n* Now from the host, edit `/config/config.js`, wherever you've mapped it\n\n* In most cases you want the value `public: false` to allow named users only\n\n* Setting the two prefetch values to true improves usability, but uses more storage\n\n* Once you have the configuration you want, save it and start the container again\n\n* For each user, run the command\n\n* `docker exec -it thelounge s6-setuidgid abc thelounge add <user>`\n\n* You will be prompted to enter a password that will not be echoed.\n\n* Saving logs to disk is the default, this consumes more space but allows scrollback.\n\n* To log in to the application, browse to `http://<hostip>:9000`\n\n* You should now be prompted for a username and password on the web interface.\n\n* Once logged in, you can add an IRC network. Some defaults are preset for Freenode","archived":false,"release_url":"https://github.com/linuxserver-playground/docker-thelounge/releases/tag/v4.5.2-ls6","upstream_version":"v4.5.2","base":"alpine","releases":[{"branch":"master","release_tag":"latest","channel":"stable","tag":"v4.5.2-ls6","upstream_version":"v4.5.2","created":"2026-11-12T18:33:29Z","release_url":"https://github.com/linuxserver-playground/docker-thelounge/releases/tag/v4.5.2-ls6","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.22","platforms":["amd64","arm64"]},{"branch":"next","release_tag":"next","channel":"prerelease","tag":"next-v4.6.0-pre.2-ls6","upstream_version":"v4.6.0-pre.2","created":"2026-11-13T19:57:02Z","release_url":"https://github.com/linuxserver-playground/docker-thelounge/releases/tag/next-v4.6.0-pre.2-ls6","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.22","platforms":["amd64","arm64"]},{"branch":"nightly","release_tag":"nightly","channel":"prerelease","tag":"nightly-70db8bcb-ls6","upstream_version":"70db8bcb","created":"2026-11-13T22:41:00Z","release_url":"https://github.com/linuxserver-playground/docker-thelounge/releases/tag/nightly-70db8bcb-ls6","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.22","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/thelounge/","registries":{"ghcr":"ghcr.io/linuxserver-playground/thelounge","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/thelounge"},"snippets":{"docker_compose":"---\nservices:\n  thelounge:\n    image: ghcr.io/linuxserver-playground/thelounge:latest\n    container_name: thelounge\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n    volumes:\n      - /path/to/thelounge/config:/config\n    ports:\n      - 9000:9000\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=thelounge \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -p 9000:9000 \\\n  -v /path/to/thelounge/config:/config \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/thelounge:latest\n"},"links":{"builds":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/builds.json","docs":"https://linuxserver-playground.github.io/hub/stores/docs/images/docker-thelounge.md","documentation":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/docs.json","proxy":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/proxy.json","kubernetes":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/kubernetes.yaml","quadlet":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/quadlet.container","mods":"https://linuxserver-playground.github.io/hub/api/v1/catalog/thelounge/mods.json"}}}}