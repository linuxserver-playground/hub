# grav.container: generated by the hub from https://github.com/linuxserver-playground/docker-grav/blob/main/image.yml
# Optional parameters are commented out.

[Unit]
Description=Grav (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/grav:latest
ContainerName=grav
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/grav/config:/config:Z
PublishPort=80:80

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
