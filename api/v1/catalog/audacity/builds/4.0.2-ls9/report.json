mit (3cdd266 → fd6e945): the pipeline's own package table update"],"upstream":{"from":"4.0.2","to":"4.0.2","changed":false},"base_changed":true,"base_from":"sha256:68e4d60f26e237857c52b47113d8135055e5840b247227da77f264bf97588f56","size":{"amd64":{"from":989807588,"to":987510162,"delta":-2297426}},"totals":{"added":0,"removed":1,"upgraded":58,"downgraded":1},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":1752,"distro":"Ubuntu 26.04.1 LTS","hash":"79a80f6f","by_type":{"UnknownPackage":13,"python":112,"deb":725,"go-module":876,"rpm":25,"binary":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-audacity/compare/4.0.2-ls8...4.0.2-ls9","upstream":"While we work hard to add new features and bring back missing ones in the upcoming 4.1, this patch release fixes many crashes and project corruption issues.\r\n\r\n- #12544 Fixed project corruption when loading projects that contain empty clips.\r\n- #12123 Fixed duplicate .aup4 extensions and errors when replacing projects during Save As.\r\n- #12436 Fixed project corruption when copying between projects.\r\n- #12436 Fixed incorrect pitch and clip loss when moving clips across tracks with different sample rates.\r\n- #12569 Fixed a crash when opening projects with sample snapping enabled.\r\n- #12573 Fixed a crash when selecting Repeat Last Effect after closing a project.\r\n- #12595 Fixed a crash when the Split shortcut is not set.\r\n- #12515 Fixed missing metadata in certain file formats and incorrect title and artist fields.\r\n- #12539 Restored automatic saving during recording.\r\n- #12570 Restored trim, clear selection, and zoom shortcuts. Added PgUp and PgDown timeline scrolling.\r\n- #12292 Fixed NTSC frame snapping.\r\n- #12181 Fixed point labels linking to adjacent labels and guidelines during label stretching\r\n- #12205 Fixed context menu access on collapsed clips.\r\n- #12431 Improved playback latency from input meter display.\r\n- #12151 Improved the status bar layout in narrow windows.\r\n- muse_framework#365 Linux: Fixed File > Import returning no files. (Thanks, @jonata!)\r\n- muse_framework#357 Fixed incorrect handling of CJK characters during text trimming. (Thanks, @xphenomenon!)","upstream_url":"https://github.com/audacity/audacity/releases/tag/Audacity-4.0.2"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Audacity","LSIO_FIRST_PARTY=true","NO_GAMEPAD=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/audacity/builds/4.0.2-ls9.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/audacity/builds/4.0.2-ls9/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/audacity/builds/4.0.2-ls9/layers.amd64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-audacity/releases/tag/4.0.2-ls9","pages":"https://linuxserver-playground.github.io/docker-audacity/builds/4.0.2-ls9/","files":{"amd64":"https://linuxserver-playground.github.io/docker-audacity/builds/4.0.2-ls9/files.amd64.json.gz"},"sbom":{"amd64":"https://linuxserver