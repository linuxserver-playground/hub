# wikijs.container: generated by the hub from https://github.com/linuxserver-playground/docker-wikijs/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Wikijs (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/wikijs:latest
ContainerName=wikijs
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
# Environment=DB_TYPE=sqlite
# Environment=DB_HOST=
# Environment=DB_PORT=
# Environment=DB_NAME=
# Environment=DB_USER=
# Environment=DB_PASS=
Volume=/path/to/wikijs/config:/config:Z
Volume=/path/to/data:/data:Z
PublishPort=3000:3000

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
