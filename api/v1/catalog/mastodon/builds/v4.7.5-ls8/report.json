","1 commit (2b18a07 → 38b0b54): the pipeline's own package table update"],"upstream":{"from":"v4.7.5","to":"v4.7.5","changed":false},"base_changed":true,"base_from":"sha256:a5464bb0b85935854231e0dfa14bd55963c132d4acdfc3f5997de04f2e2bfa52","size":{"amd64":{"from":254860618,"to":254806387,"delta":-54231},"arm64":{"from":251187438,"to":251135087,"delta":-52351}},"totals":{"added":0,"removed":0,"upgraded":12,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":855,"distro":"Alpine Linux v3.24","hash":"f95ae6f1","by_type":{"npm":157,"apk":247,"gem":334,"rust-crate":115,"php-composer":1,"java-archive":1}},"arm64":{"count":856,"distro":"Alpine Linux v3.24","hash":"8369f67d","by_type":{"npm":157,"apk":248,"gem":334,"rust-crate":115,"php-composer":1,"java-archive":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-mastodon/compare/v4.7.5-ls7...v4.7.5-ls8","upstream":"<h1><picture>\r\n  <source media=\"(prefers-color-scheme: dark)\" srcset=\"./lib/assets/wordmark.dark.png?raw=true\">\r\n  <source media=\"(prefers-color-scheme: light)\" srcset=\"./lib/assets/wordmark.light.png?raw=true\">\r\n  <img alt=\"Mastodon\" src=\"./lib/assets/wordmark.light.png?raw=true\" height=\"34\">\r\n</picture></h1>\r\n\r\n## Changelog\r\n\r\n### Security\r\n\r\n- Fix password authentication bypass for inactive accounts ([GHSA-3xjw-gv43-3w62](https://github.com/mastodon/mastodon/security/advisories/GHSA-3xjw-gv43-3w62))\r\n- Fix DoS through JSON-LD compaction (#41482 by @ClearlyClaire, [GHSA-cf49-73r7-rxj6](https://github.com/mastodon/mastodon/security/advisories/GHSA-cf49-73r7-rxj6))\r\n- Fix `Forwarded` header taking precedence over `X-Forwarded-For` (#41481 by @ClearlyClaire, [GHSA-qp4r-p842-mw5c](https://github.com/mastodon/mastodon/security/advisories/GHSA-qp4r-p842-mw5c))\r\n  - If your reverse-proxy setup uses `Forwarded` instead of `X-Forwarded-For`, please make sure it ignores user-provided `X-Forwarded-For` headers.\r\n  - If you are using our provided `nginx.conf`, please consider updating it.\r\n- Updated dependencies, in particular to address security advisories in `addressable`, `loofah`, `rack`, and `rails-html-sanitizer`\r\n\r\n### Changed\r\n\r\n- Change invites use counts to not decrease if an invited user deletes their account (#41458 by @ClearlyClaire)\r\n\r\n## Upgrade notes\r\n\r\nTo get the code for v4.7.5, use `git fetch && git checkout v4.7.5`.\r\n\r\n> [!NOTE]\r\n> As always, make sure you have backups of the database before performing any upgrades. If you are using docker-compose, this is how a backup command might look: `docker exec mastodon_db_1 pg_dump -Fc -U postgres postgres > name_of_the_backup.dump`\r\n\r\n### Dependencies\r\n\r\nExternal dependencies have not changed since v4.6.0.\r\n\r\n- Ruby: 3.3 or newer\r\n- PostgreSQL: 14 or newer\r\n- Elasticsearch (recommended, for full-text search): 7.x (OpenSearch should also work)\r\n- LibreTranslate (optional, for translations): 1.3.3 or newer\r\n- Redis: 7.0 or newer\r\n- Node: 22 or newer\r\n- libvips: 8.13 or newer\r\n- FFMpeg: 5.1 or newer\r\n\r\n### Update steps\r\n\r\nThe following instructions are for updating from 4.7.4.\r\n\r\nIf you are upgrading directly from an earlier release, please carefully read the upgrade notes for the skipped releases as well, as they often require extra steps such as database migrations. In particular, it is very important to read the [4.7.0 release notes](https://github.com/mastodon/mastodon/releases/tag/v4.7.0).\r\n\r\n### Non-Docker\r\n\r\n> [!TIP]\r\n> The `charlock_holmes` gem may fail to build on some systems with recent versions of gcc.\r\nIf you run into this issue, try `BUNDLE_BUILD__CHARLOCK_HOLMES=\"--with-cxxflags=-std=c++17\" bundle install`.\r\n\r\n1. Install dependencies with `bundle install` and `yarn install --immutable`\r\n2. Restart all Mastodon processes.\r\n\r\n### When using Docker\r\n\r\n1. Restart all Mastodon processes.","upstream_url":"https://github.com/mastodon/mastodon/releases/tag/v4.7.5"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/app/www/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/init-hook","VIRTUAL_ENV=/lsiopy","PHP_INI_SCAN_DIR=:/config/php","LSIO_FIRST_PARTY=true","RAILS_ENV=production","NODE_ENV=production","MASTODON_USE_LIBVIPS=true"],"exposed_ports":["443/tcp","80/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mastodon/builds/v4.7.5-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mastodon/builds/v4.7.5-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mastodon/builds/v4.7.5-ls8/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/mastodon/builds/v4.7.5-ls8/layers.arm64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-mastodon/releases/tag/v4.7.5-ls8","pages":"https://linuxserver-playground.github.io/docker-mastodon/builds/v4.7.5-ls8/","files":{"amd64":"https://linuxserver-playground.github.io/docker-mastodon/builds/v4.7.5-ls8/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-mastodon/builds/v4.7.5-ls8/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-mastodon/builds/v4.7.5-ls8/packages.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-mastodon/builds/v4.7.5-ls8/packages.arm64.json.gz"},"run_json":"https://github.com/linuxserver-playground/docker-mastodon/releases/download/v4.7.5-ls8/run.json","logs_zip":"https://github.com/linuxserver-playground/docker-mastodon/releases/download/v4.7.5-ls8/logs.zip","test_report":"https://linuxserver-playground.github.io/site/images/mastodon/builds/v4.7.5-ls8/