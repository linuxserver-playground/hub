min\n* Default Password: admin\n`change password ASAP.`","archived":false,"release_url":"https://github.com/linuxserver-playground/docker-znc/releases/tag/znc-1.10.3-ls5","upstream_version":"znc-1.10.3","base":"alpine","releases":[{"branch":"master","release_tag":"latest","channel":"stable","tag":"znc-1.10.3-ls5","upstream_version":"znc-1.10.3","created":"2026-11-08T04:48:43Z","release_url":"https://github.com/linuxserver-playground/docker-znc/releases/tag/znc-1.10.3-ls5","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.22","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/znc/","registries":{"ghcr":"ghcr.io/linuxserver-playground/znc","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/znc"},"snippets":{"docker_compose":"---\nservices:\n  znc:\n    image: ghcr.io/linuxserver-playground/znc:latest\n    container_name: znc\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n    volumes:\n      - /path/to/znc/config:/config\n    ports:\n      - 6501:6501\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=znc \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -p 6501:6501 \\\n  -v /path/to/znc/config:/config \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/znc:latest\n"},"links":{"builds":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc/builds.json","docs":"https://linuxserver-playground.github.io/hub/stores/docs/images/docker-znc.md","documentation":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc/docs.json","proxy":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc/proxy.json","kubernetes":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc/kubernetes.yaml","quadlet":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc/quadlet.container","mods":"https://linuxserver-playground.github.io/hub/api/v1/catalog/znc