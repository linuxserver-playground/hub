{"status":"OK","last_updated":"2026-11-14 11:23:23+00:00","data":{"image":{"name":"znc","initial_date":"2015-12-11","github_url":"https://github.com/linuxserver-playground/docker-znc","project_url":"http://wiki.znc.in/ZNC","project_logo":"https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/znc-logo.png","description":"[Znc](http://wiki.znc.in/ZNC) is an IRC network bouncer or BNC. It can detach the client from the actual IRC server, and also from selected channels. Multiple clients from different locations can connect to a single ZNC account simultaneously and therefore appear under the same nickname on IRC.","version":"znc-1.10.3-ls5","version_timestamp":"2026-11-08 04:48:43+00:00","category":"IRC","stable":true,"deprecated":false,"stars":0,"tags":[{"tag":"latest","desc":"Stable releases"}],"architectures":[{"arch":"x86_64","tag":"amd64-latest"},{"arch":"arm64","tag":"arm64v8-latest"}],"changelog":[{"date":"2025-07-27","desc":"Rebase to Alpine 3.22."},{"date":"2024-06-10","desc":"Migrate default config file to newer format."},{"date":"2024-06-06","desc":"Rebase to Alpine 3.20."},{"date":"2024-03-26","desc":"Switch back to multi-threaded builds and ignore `-beta` and `-alpha` tags as well as `-rc`."},{"date":"2024-02-22","desc":"Update build system for v1.9.0 (use cmake)."},{"date":"2023-12-23","desc":"Rebase to Alpine 3.19."},{"date":"2023-07-12","desc":"Rebasing to Alpine 3.18."},{"date":"2023-07-07","desc":"Deprecate armhf. As announced [here](https://www.linuxserver.io/blog/a-farewell-to-arm-hf)"},{"date":"2023-02-13","desc":"Rebase to Alpine 3.17, migrate to s6v3."},{"date":"2022-01-19","desc":"Rebasing to alpine 3.15."},{"date":"2020-06-01","desc":"Rebasing to alpine 3.12."},{"date":"2019-12-19","desc":"Rebasing to alpine 3.11."},{"date":"2019-11-02","desc":"Add znc-palaver module."},{"date":"2019-06-28","desc":"Rebasing to alpine 3.10."},{"date":"2019-03-23","desc":"Switching to new Base images, shift to arm32v7 tag."},{"d