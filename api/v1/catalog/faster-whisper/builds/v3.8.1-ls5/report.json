 no-op for the same reason — it fed\n    128 samples, far less than one chunk — so the first transcription paid for\n    the warm-up","upstream_url":"https://github.com/OHF-Voice/wyoming-faster-whisper/releases/tag/v3.8.1"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","LSIO_FIRST_PARTY=true","DEBIAN_FRONTEND=noninteractive","TMPDIR=/run/whisper-temp"],"exposed_ports":["10300/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5/layers.arm64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5/packages.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/faster-whisper/builds/v3.8.1-ls5/packages.arm64.json"},"release":"https://github.com/linuxserver-playground/docker-faster-whisper/releases/tag/v3.8.1-ls5","pages":"https://linuxserver-playground.github.io/docker-faster-whisper/builds/v3.8.1-ls5/","files":{"amd64":"https://linuxserver-playground.github.io/docker-faster-whisper/builds/v3.8.1-ls5/files.amd64.json.gz","arm64":"https://linuxserver-playground.github.io/docker-faster-whisper/builds/v3.8.1-ls5/files.arm64.json.gz"},"sbom":{"amd64":"https://linuxserver-playground.github.io/docker-faster-whisper/builds/v3.8.1-ls5/packages.amd64.json.gz","arm64":"https://lin