# grocy.container: generated by the hub from https://github.com/linuxserver-playground/docker-grocy/blob/master/image.yml
# Optional parameters are commented out.

[Unit]
Description=Grocy (LinuxServer.io)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/linuxserver-playground/grocy:latest
ContainerName=grocy
AutoUpdate=registry
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Etc/UTC
Volume=/path/to/grocy/config:/config:Z
PublishPort=9283:80

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
