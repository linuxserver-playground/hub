uts in apps such as tvheadend.","archived":false,"release_url":"https://github.com/linuxserver-playground/docker-minisatip/releases/tag/v2.0.189-ls5","upstream_version":"v2.0.189","base":"ubuntu","releases":[{"branch":"master","release_tag":"latest","channel":"stable","tag":"v2.0.189-ls5","upstream_version":"v2.0.189","created":"2026-11-04T23:38:46Z","release_url":"https://github.com/linuxserver-playground/docker-minisatip/releases/tag/v2.0.189-ls5","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-ubuntu:noble","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/minisatip/","registries":{"ghcr":"ghcr.io/linuxserver-playground/minisatip","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/minisatip"},"snippets":{"docker_compose":"---\nservices:\n  minisatip:\n    image: ghcr.io/linuxserver-playground/minisatip:latest\n    container_name: minisatip\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n      - RUN_OPTS=\n    volumes:\n      - /path/to/minisatip/config:/config\n    ports:\n      - 8875:8875\n      - 554:554\n      - 1900:1900/udp\n    devices:\n      - /dev/dvb:/dev/dvb\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=minisatip \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -e RUN_OPTS= \\\n  -p 8875:8875 \\\n  -p 554:554 \\\n  -p 1900:1900/udp \\\n  -v /path/to/minisatip/config:/config \\\n  --device /dev/dvb:/dev/dvb \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/minisatip:latest\n"},"links":{"builds":"https://linuxserver-playground.github.io/hub/api/v1/catalog/minisatip/builds.json","docs":"https://linuxserver-playground.github.io/hub/stores/docs/images/docker-minisatip.md","documentation":"https://linuxserver-playground.github.io/hub/api/v1/catalog/minisatip/docs.json","proxy":"https://linuxserver-playground.github.io/hub/api/v1/catalog/minisatip/proxy.json","kuber