ch the image changed (image.yml or root/)","base image digest changed","packages changed","6 commits (84e75b9 → 9fe9c3e): changed image.yml, generated files, the package table"],"upstream":{"from":"2.71.0","to":"2.72.0","changed":true},"base_changed":true,"base_from":"sha256:df6a63d8627d7f06e292f4e4cff695743d92f8735617ff755470962e58fd75f5","size":{"amd64":{"from":133847071,"to":135769049,"delta":1921978},"arm64":{"from":134462405,"to":136369051,"delta":1906646}},"totals":{"added":2,"removed":0,"upgraded":148,"downgraded":2},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":274,"distro":"Alpine Linux v3.24","hash":"3c7f30f2","by_type":{"binary":1,"apk":126,"php-composer":146,"npm":1}},"arm64":{"count":274,"distro":"Alpine Linux v3.24","hash":"3c7f30f2","by_type":{"binary":1,"apk":126,"php-composer":146,"npm":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-kimai/compare/2.71.0-ls7...2.72.0-ls8","upstream":"**Compatible with PHP 8.2 to 8.5**\r\n\r\n## Features & Maintenance\r\n\r\n- Bump Docker to PHP 8.5, use custom ICU data to fix timezone issues in some countries (#6318)\r\n- Search invoice history by invoice number (#6287) - thanks @Deniiz23 \r\n- Highlight unpaid invoices in listings\r\n- Run the search on Enter instead of saving the filter as default (invoice & export screen) (#6291) - thanks @dgesteves \r\n- Run `pnpm lint` during CI\r\n- Updated translations (#6292) (#6306)\r\n- Fix twig deprecations: missing default parameter in macros\r\n- Improved invoice overdue calculation (internal API bug, no visible changes)\r\n- Bumped frontend and composer packages\r\n\r\n## Bugfixes\r\n\r\n- Keep the calendar month in the URL on reload (#6324) - thanks @shu-chen-dot-ca \r\n- Use correct TTL settings for \"password reset\" links\r\n- Reduce default TTL for \"password reset\" links to 0.5h\r\n- Use consistent currency aware monetary rounding half-up, mainly for invoices (#6317)\r\n- Memory safe export preview (#6295)\r\n- Do not fail on unpersisted entities in rate calculation (mass import via internal API)\r\n\r\n## 🚨 Security\r\n\r\n- Disable login route if SAML is active and user disabled form login (#6311) - thanks @mrtxmrtx\r\n- Validate custom-field values submitted via API (#6301) - thanks @wleeaf and @manus-pi\r\n- Fix locale route matching in global firewall - thanks @petertornstrand \r\n- Harden twig security policy - thanks @manus-pi\r\n\r\nYou can read more about all security reports [here](https://www.kimai.org/documentation/bughunter.html#published-vulnerabilities) or grab this [RSS feed](https://www.kimai.org/security.xml) to get notified about new published advisories.\r\n\r\nAlso involved in this release: @kevinpapst, @weblate, Andrei Stepanov, @aspopovic, @Deniiz23, @dgesteves, Gabriel, Phil, testecelular and @Watchman89\r\n","upstream_url":"https://github.com/kimai/kimai/releases/tag/2.72.0"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","PS1=$(whoami)@$(hostname):$(pwd)\\$ ","HOME=/root","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","PHP_INI_SCAN_DIR=:/config/php","LSIO_FIRST_PARTY=true"],"exposed_ports":["443/tcp","80/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/kimai/builds/2.72.0-ls8.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/kimai/builds/2.72.0-ls8/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/kimai/builds/2.72.0-ls8/layers.amd64.json","arm64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/kimai/builds/2.72.0-ls8/layers.arm64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/kimai/builds/2.72.0-ls8/packages.amd64.json","arm64":"https://linuxserver-playground.github.io/hu