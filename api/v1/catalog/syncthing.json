{"status":"OK","last_updated":"2026-11-07 14:37:33+00:00","data":{"image":{"name":"syncthing","initial_date":"2015-09-24","github_url":"https://github.com/linuxserver-playground/docker-syncthing","project_url":"https://syncthing.net","project_logo":"https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/syncthing-banner.png","description":"[Syncthing](https://syncthing.net) replaces proprietary sync and cloud services with something open, trustworthy and decentralized. Your data is your data alone and you deserve to choose where it is stored, if it is shared with some third party and how it's transmitted over the Internet.","version":"v2.1.7-ls3","version_timestamp":"2026-10-30 20:24:13+00:00","category":"Backup","stable":true,"deprecated":false,"stars":0,"tags":[{"tag":"latest","desc":"Stable releases"}],"architectures":[{"arch":"x86_64","tag":"amd64-latest"},{"arch":"arm64","tag":"arm64v8-latest"}],"changelog":[{"date":"2026-09-10","desc":"Rebase to Alpine 3.24. Compile on Alpine edge."},{"date":"2026-03-03","desc":"Rebase to Alpine 3.23."},{"date":"2025-08-16","desc":"Rebase to Alpine 3.22."},{"date":"2025-08-13","desc":"Use double-dash long options for syncthing v2.0.0."},{"date":"2024-12-03","desc":"Rebase to Alpine 3.21."},{"date":"2024-06-06","desc":"Rebase to Alpine 3.20."},{"date":"2024-03-05","desc":"Rebase to Alpine 3.19."},{"date":"2023-09-05","desc":"Rebase to Alpine 3.18."},{"date":"2023-07-01","desc":"Deprecate armhf. As announced [here](https://www.linuxserver.io/blog/a-farewell-to-arm-hf)"},{"date":"2023-02-13","desc":"Rebase to Alpine 3.17, migrate to s6v3."},{"date":"2022-08-17","desc":"Build on alpine 3.16 for go 1.18)."},{"date":"2022-05-03","desc":"Rebase to alpine 3.15 (builds on edge for go 1.18)."},{"date":"2021-10-05","desc":"Rebase to alpine 3.14."},{"date":"2021-05-12","desc":"Remove sysctl parameter again"},{"date":"2021-05-03","desc":"Raise maximum UDP buffer size."},{"date":"2021-05-03","desc":"Add port mapping for 22000/udp."},{"date":"2021-01-29","desc":"Deprecate `UMASK_SET` in favor of UMASK in baseimage, see above for more information."},{"date":"2021-01-23","desc":"Rebasing to alpine 3.13."},{"date":"2020-09-15","desc":"Use go from alpine edge repo to compile. Remove duplicate UMASK env var. Add hostname setting."},{"date":"2020-06-01","desc":"Rebasing to alpine 3.12."},{"date":"2019-12-19","desc":"Rebasing to alpine 3.11."},{"date":"2019-06-28","desc":"Rebasing to alpine 3.10."},{"date":"2019-03-23","desc":"Switching to new Base images, shift to arm32v7 tag."},{"date":"2019-03-05","desc":"Update Build process for v1.1.0 release."},{"date":"2019-02-22","desc":"Rebasing to alpine 3.9."},{"date":"2019-01-16","desc":"Add pipeline logic and multi arch."},{"date":"2018-07-30","desc":"Rebase to alpine 3.8 and use buildstage."},{"date":"2017-12-13","desc":"Rebase to alpine 3.7."},{"date":"2017-10-25","desc":"Add env for manual setting of umask."},{"date":"2017-07-29","desc":"Simplify build structure as symlinks failing on > 0.14.32"},{"date":"2017-05-28","desc":"Rebase to alpine 3.6."},{"date":"2017-02-08","desc":"Rebase to alpine 3.5."},{"date":"2016-11-01","desc":"Switch to compiling latest version from git source."},{"date":"2016-10-14","desc":"Add version layer information."},{"date":"2016-09-30","desc":"Fix umask."},{"date":"2016-09-09","desc":"Add layer badges to README."},{"date":"2016-08-28","desc":"Add badges to README."},{"date":"2016-08-11","desc":"Rebase to alpine linux."},{"date":"2015-12-18","desc":"Initial testing / release (IronicBadger)"},{"date":"2015-09-24","desc":"Inital dev complete (Lonix)"}],"config":{"application_setup":"https://github.com/linuxserver-playground/docker-syncthing?tab=readme-ov-file#application-setup","hostname":{"hostname":"syncthing","desc":"Optionally the hostname can be defined.","optional":true},"env_vars":[{"name":"PUID","value":"1000","desc":"User ID","optional":false},{"name":"PGID","value":"1000","desc":"Group ID","optional":false},{"name":"TZ","value":"Etc/UTC","desc":"Timezone","optional":false}],"volumes":[{"path":"/config","host_path":"/path/to/syncthing/config","desc":"Configuration files.","optional":false},{"path":"/data1","host_path":"/path/to/data1","desc":"Data1","optional":false},{"path":"/data2","host_path":"/path/to/data2","desc":"Data2","optional":false}],"ports":[{"external":"8384","internal":"8384","desc":"Application WebUI","optional":false},{"external":"22000","internal":"22000/tcp","desc":"Listening port (TCP)","optional":false},{"external":"22000","internal":"22000/udp","desc":"Listening port (UDP)","optional":false},{"external":"21027","internal":"21027/udp","desc":"Protocol discovery","optional":false}]},"title":"Syncthing","sponsor":[{"name":"Syncthing","url":"https://syncthing.net/donations/"},{"name":"Syncthing (GitHub Sponsors)","url":"https://github.com/sponsors/syncthing"}],"maintainers":[],"kind":"app","categories":["Backup"],"setup_instructions":"**Note: ** The Syncthing devs highly suggest setting a password for this container as it listens on 0.0.0.0. To do this go to `Actions -> Settings -> set user/password` for the webUI.","archived":false,"release_url":"https://github.com/linuxserver-playground/docker-syncthing/releases/tag/v2.1.7-ls3","upstream_version":"v2.1.7","base":"alpine","releases":[{"branch":"master","release_tag":"latest","channel":"stable","tag":"v2.1.7-ls3","upstream_version":"v2.1.7","created":"2026-10-30T20:24:13Z","release_url":"https://github.com/linuxserver-playground/docker-syncthing/releases/tag/v2.1.7-ls3","test_success":true,"base":"ghcr.io/linuxserver-playground/baseimage-alpine:3.24","platforms":["amd64","arm64"]}],"docs_url":"https://linuxserver-playground.github.io/site/images/syncthing/","registries":{"ghcr":"ghcr.io/linuxserver-playground/syncthing","packages_url":"https://github.com/orgs/linuxserver-playground/packages/container/package/syncthing"},"snippets":{"docker_compose":"---\nservices:\n  syncthing:\n    image: ghcr.io/linuxserver-playground/syncthing:latest\n    container_name: syncthing\n    hostname: syncthing #optional\n    environment:\n      - PUID=1000\n      - PGID=1000\n      - TZ=Etc/UTC\n    volumes:\n      - /path/to/syncthing/config:/config\n      - /path/to/data1:/data1\n      - /path/to/data2:/data2\n    ports:\n      - 8384:8384\n      - 22000:22000/tcp\n      - 22000:22000/udp\n      - 21027:21027/udp\n    restart: unless-stopped\n","docker_run":"docker run -d \\\n  --name=syncthing \\\n  --hostname=syncthing `#optional` \\\n  -e PUID=1000 \\\n  -e PGID=1000 \\\n  -e TZ=Etc/UTC \\\n  -p 8384:8384 \\\n  -p 22000:22000/tcp \\\n  -p 22000:22000/udp \\\n  -p 21027:21027/udp \\\n  -v /path/to/syncthing/config:/config \\\n  -v /path/to/data1:/data1 \\\n  -v /path/to/data2:/data2 \\\n  --restart unless-stopped \\\n  ghcr.io/linuxserver-playground/syncthing:latest\n"},"links":{"builds":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/builds.json","docs":"https://linuxserver-playground.github.io/hub/stores/docs/images/docker-syncthing.md","documentation":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/docs.json","proxy":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/proxy.json","kubernetes":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/kubernetes.yaml","quadlet":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/quadlet.container","mods":"https://linuxserver-playground.github.io/hub/api/v1/catalog/syncthing/mods.json"}}}}