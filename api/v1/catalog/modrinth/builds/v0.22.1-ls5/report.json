changed"],"upstream":{"from":"v0.22.1","to":"v0.22.1","changed":false},"base_changed":false,"size":{"amd64":{"from":1071582262,"to":1071582281,"delta":19}},"totals":{"added":0,"removed":0,"upgraded":0,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":1766,"distro":"Ubuntu 26.04.1 LTS","hash":"69b6cc96","by_type":{"UnknownPackage":13,"python":109,"deb":748,"go-module":870,"rpm":25,"binary":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-modrinth/compare/v0.22.1-ls4...v0.22.1-ls5","upstream":"## Changed\n\n- File drop areas, such as in the Skin selector, now highlight while dragging and show a spinner while files process.\n- Updated translations. Want to help translate Modrinth App? [Click here](https://translate.modrinth.com/)\n- Depends on filter styling for app.\n- **Modrinth Hosting:** Updated translations. Want to help translate Modrinth Hosting? [Click here](https://translate.modrinth.com/)\n- **Modrinth Hosting:** When resubscribing to a Modrinth Hosting server, it will now let you switch payment method and preview the tax (if any) that you will be additionally charged.\n\n## Removed\n\n- Removed \"Verify and restore\" action from the Resources tab of app settings.\n\n## Fixed\n\n- Fixed Minecraft 1.8.9 failing to launch on Apple Silicon Macs.\n- Fixed Modrinth App slowing down or stalling while installing or updating large amounts of content.\n- Fixed files dragged into Modrinth App dropping onto the wrong area on macOS and Linux with display scaling.\n- Improved loading speed of the Versions page for projects that support many game versions.\n- Fixed searchable dropdowns flickering while typing. Selecting the arrow icon now opens and closes the dropdown.\n- Fixed instance name sort to also be alphanumerical instead of only alphabetical.\n- Fixed issue where you cannot open an instance with track pad.\n- Fixed drag to resize slider is to handle multiple jump back in columns.\n- Padded bottom of search filters in sidebar since last item can be covered by \"Upgrade to Modrinth+\" link.\n- **Modrinth Hosting:** Fixed the Created and Created by columns being too narrow in the backup history table on the Backups tab.\n- **Modrinth Hosting:** Depends on search filter opened below, where it can be covered by app ad box.\n\n## Added\n\n- **Modrinth Hosting:** You can now use the icon editor to create an icon for your server in the General settings tab of the server panel settings modal.\n","upstream_url":"https://github.com/modrinth/code/releases/tag/v0.22.1"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Modrinth","LSIO_FIRST_PARTY=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":false,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.22.1-ls5.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.22.1-ls5/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.22.1-ls5/layers.amd64.json"},"packages":{},"release":"https://github.com/linuxserver-playground/docker-modrinth/releases/tag/v