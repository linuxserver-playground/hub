ge digest changed","packages changed","1 commit (05d319a → 8522964): the pipeline's own package table update"],"upstream":{"from":"v0.23.4","to":"v0.23.4","changed":false},"base_changed":true,"base_from":"sha256:ff2e19f8abb56607bd671bdd470eb77c95bb3bf5dca37bfd66c86b684a3c5182","size":{"amd64":{"from":1025927616,"to":1025963390,"delta":35774}},"totals":{"added":0,"removed":1,"upgraded":12,"downgraded":0},"config_changes":0,"dockerfile_changed":[]},"packages":{"amd64":{"count":1772,"distro":"Ubuntu 26.04.1 LTS","hash":"538d906c","by_type":{"UnknownPackage":13,"python":109,"deb":748,"go-module":876,"rpm":25,"binary":1}}},"notes":{"linuxserver":"**Full Changelog**: https://github.com/linuxserver-playground/docker-modrinth/compare/v0.23.4-ls10...v0.23.4-ls11","upstream":"## Changed\n\n- Skin previews on the Skins page now load faster, at about 20-30 ms per skin.\n- Replaced the username field in Profile settings with a Change username button that opens the website, and added a Refresh profile button.\n- Raised the shared instance limits to 16,384 files and 2 GB per version.\n- Use paste.modrinth.com for app logs and errors to make support easier.\n\n## Fixed\n\n- Fixed modpacks failing to install when an override file has a name that Windows does not allow, such as \\`CON.txt\\`.\n- Fixed shared instances failing to install a file after you chose to continue past the external files warning.\n- Fixed instance icons larger than 8192 pixels failing to load.\n- Fixed instance creation failing when the instance icon can't be downloaded.\n- Fixed Java 16 and 18 failing to install on macOS and Linux.\n- Fixed local NeoForge mods showing their banner instead of their icon in the instance content list.\n- Fixed game settings changed while Modrinth App was closed being overwritten on the next launch when Sync game settings is on.\n- Fixes some issues with importing instances from CurseForge, Prism and MultiMC.\n\n## Security\n\n- Disabled base64 intrinsics to prevent java4shell.\n- Fixed \"Export debug info\" in Troubleshooting settings including sensitive information.\n- IP addresses, computer usernames in file paths, and other sensitive information is now censored in instance logs and debug info exports.\n- **Modrinth Hosting:** Fixed payments accepting a charge that belongs to another account.\n","upstream_url":"https://github.com/modrinth/code/releases/tag/v0.23.4"},"config":{"env":["PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin","HOME=/config","LANGUAGE=en_US.UTF-8","LANG=en_US.UTF-8","TERM=xterm","S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0","S6_VERBOSITY=1","S6_STAGE2_HOOK=/docker-mods","VIRTUAL_ENV=/lsiopy","DISPLAY=:1","PERL5LIB=/usr/local/bin","START_DOCKER=true","PULSE_RUNTIME_PATH=/defaults","SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so","SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so","NVIDIA_DRIVER_CAPABILITIES=all","DISABLE_DRI3=false","SELKIES_ENCODER=h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg","SELKIES_ENABLE_BASIC_AUTH=false","SELKIES_VIDEO_STREAMING_MODE=false","SELKIES_ALLOWED_ORIGINS=*","SELKIES_RATE_CONTROL_MODE=crf,cbr","SHELL=/bin/bash","__GL_SYNC_TO_VBLANK=0","TITLE=Modrinth","LSIO_FIRST_PARTY=true","PIXELFLUX_WAYLAND=true"],"exposed_ports":["3000/tcp","3001/tcp"],"volumes":["/config"],"entrypoint":["/init"],"working_dir":"/"},"is_newest":true,"links":{"build":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.23.4-ls11.json","diff":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.23.4-ls11/diff.json","layers":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.23.4-ls11/layers.amd64.json"},"packages":{"amd64":"https://linuxserver-playground.github.io/hub/api/v1/catalog/modrinth/builds/v0.23.4-ls11/packages.amd64.json"},"release":"https://github.com/linuxserver-playground/docker-modrinth/releases/tag/v0.23.4-ls11","pages":"https://linuxserver-playground.github.io/docker-modr